  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LekhaBook.Data.Sqlite/LekhaBook.Data.Sqlite.csproj" />
    <ProjectReference Include="../../src/LekhaBook.Data.Postgres/LekhaBook.Data.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
