# Copy to deploy/.env and fill in strong production values before running docker compose.
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_32_CHAR_PASSWORD
API_DOMAIN=api.lekhabooks.com
WEB_DOMAIN=app.lekhabooks.com
AUTH_RATE_LIMIT=30
MIGRATE_ON_STARTUP=false

# ---- Payment Billing (Online Cloud Mode) ----
BILLING_ENFORCE_LIMITS=true
BILLING_SANDBOX_TEST=false

# eSewa ePay v2 (Nepal)
ESEWA_ENABLED=false
ESEWA_USE_SANDBOX=false
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=

# Khalti KPG-2 (Nepal)
KHALTI_ENABLED=false
KHALTI_USE_SANDBOX=false
KHALTI_SECRET_KEY=

# Stripe (Global Cards / Apple Pay / Google Pay)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
