# Production multi-stage build for LekhaBook.Api (.NET 10)
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY Directory.Build.props Directory.Packages.props global.json ./
COPY src/LekhaBook.Domain/LekhaBook.Domain.csproj src/LekhaBook.Domain/
COPY src/LekhaBook.Contracts/LekhaBook.Contracts.csproj src/LekhaBook.Contracts/
COPY src/LekhaBook.Application/LekhaBook.Application.csproj src/LekhaBook.Application/
COPY src/LekhaBook.Data/LekhaBook.Data.csproj src/LekhaBook.Data/
COPY src/LekhaBook.Data.Postgres/LekhaBook.Data.Postgres.csproj src/LekhaBook.Data.Postgres/
COPY src/LekhaBook.Api/LekhaBook.Api.csproj src/LekhaBook.Api/

RUN dotnet restore src/LekhaBook.Api/LekhaBook.Api.csproj

COPY src/ src/
RUN dotnet publish src/LekhaBook.Api/LekhaBook.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Create durable mount points for attachments and data protection keys
RUN mkdir -p /data/attachments /data/keys && chown -R app:app /data /app
USER app

ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production
ENV Storage__RootPath=/data/attachments
ENV DataProtection__KeysPath=/data/keys
ENV Proxy__TrustForwardedHeaders=true

COPY --from=build /app/publish .
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://localhost:8080/health || exit 1

ENTRYPOINT ["dotnet", "LekhaBook.Api.dll"]
