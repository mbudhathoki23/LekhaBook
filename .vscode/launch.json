{
  // The MAUI app (Android / Windows) is started from the .NET MAUI extension:
  // pick a target device in the status bar, then Run > Start Debugging on LekhaBook.App.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: api",
      "program": "${workspaceFolder}/src/LekhaBook.Api/bin/Debug/net10.0/LekhaBook.Api.dll",
      "cwd": "${workspaceFolder}/src/LekhaBook.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5050"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: web",
      "program": "${workspaceFolder}/src/LekhaBook.Web/bin/Debug/net10.0/LekhaBook.Web.dll",
      "cwd": "${workspaceFolder}/src/LekhaBook.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5121"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "API + Web",
      "configurations": ["API", "Web"],
      "stopAll": true
    }
  ]
}
