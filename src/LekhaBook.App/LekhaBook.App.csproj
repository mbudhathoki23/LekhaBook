<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Android and Windows build on this PC. iOS needs a Mac (paired from Visual Studio, or built on the Mac),
         so it is only included when building on macOS or when asked for: dotnet build -p:IncludeIos=true -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) Or '$(IncludeIos)' == 'true'">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>LekhaBook.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <!-- Display name -->
    <ApplicationTitle>Lekha Books</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.lekhabook.app</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Unpackaged Windows app; switch to MSIX for store release (phase 11). -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <!-- Use the shared master artwork; MAUI generates each platform's icon sizes. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="..\LekhaBook.UI\wwwroot\branding\lekha_books_mark.png" ForegroundScale="0.75" Color="#FFFFFF" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="..\LekhaBook.UI\wwwroot\branding\lekha_books_mark.png" Link="Resources\Splash\lekha_books_mark.png" Color="#FFFFFF" BaseSize="160,160" Resize="true" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions follow the installed MAUI workload. -->
    <PackageReference Include="Xamarin.AndroidX.Biometric" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <PackageReference Include="Microsoft.Maui.Controls" VersionOverride="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" VersionOverride="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup Condition="'$(ApiBaseUrl)' != ''">
    <AssemblyMetadata Include="LekhaBook.ApiBaseUrl" Value="$(ApiBaseUrl)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../LekhaBook.UI/LekhaBook.UI.csproj" />
    <ProjectReference Include="../LekhaBook.Client/LekhaBook.Client.csproj" />
    <ProjectReference Include="../LekhaBook.Data.Sqlite/LekhaBook.Data.Sqlite.csproj" />
    <ProjectReference Include="../LekhaBook.Offline/LekhaBook.Offline.csproj" />
  </ItemGroup>

  <!-- A test build for a server on the local network:
       dotnet build src/LekhaBook.App -c Release -f net10.0-android -p:LekhaBookServer=http://192.168.1.20:5050/
       Only such a build allows plain HTTP; without the property, only HTTPS and the emulator host work. -->
  <ItemGroup Condition="'$(LekhaBookServer)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LekhaBookServer</_Parameter1>
      <_Parameter2>$(LekhaBookServer)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup Condition="'$(LekhaBookServer)' != '' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidResource Remove="Platforms\Android\Resources\xml\network_security_config.xml" />
    <AndroidResource Include="Platforms\Android\TestNetwork\network_security_config.xml" Link="Platforms\Android\Resources\xml\network_security_config.xml" />
  </ItemGroup>

</Project>
