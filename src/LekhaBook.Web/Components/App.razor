@using LekhaBook.Web.Services
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <title>Lekha Books</title>
    <meta name="application-name" content="Lekha Books" />
    <meta name="theme-color" content="#3949AB" />
    <link rel="icon" type="image/x-icon" href="@Assets["_content/LekhaBook.UI/branding/favicon.ico"]" />
    <link rel="apple-touch-icon" href="@Assets["_content/LekhaBook.UI/branding/apple_touch_icon.png"]" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/LekhaBook.UI/app.css"]" />
    <link rel="stylesheet" href="@Assets["LekhaBook.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    @* No prerendering: the session needs the circuit (tokens, local settings) before the first screen. *@
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)"
            InitialRefreshToken="@_refreshToken" BrowserBinding="@_binding" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    private string? _refreshToken;
    private string? _binding;

    protected override async Task OnInitializedAsync()
    {
        // Read during the plain HTTP request (the only time HttpContext is reliable) and handed to the
        // circuit as encrypted component parameters.
        _refreshToken = await HttpContext.GetTokenAsync(CookieAuthenticationDefaults.AuthenticationScheme, "refresh_token");
        _binding = WebSignIn.CurrentBinding(HttpContext);
    }
}
