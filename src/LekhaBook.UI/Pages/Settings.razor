@page "/settings"
@using LekhaBook.Domain
@inject ISessionService Session
@inject IPlatformInfo Platform
@inject ICompanyApi Companies
@inject IThemeService Theme
@inject IBackupService Backup
@inject IJSRuntime JS
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>@Loc["Settings.Title"] · Lekha Books</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4" tabindex="-1">@Loc["Settings.Title"]</MudText>

@if (Session.IsLocalMode)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-left: 4px solid var(--mud-palette-primary);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
            <div>
                <MudText Typo="Typo.subtitle1" Color="Color.Primary"><b>@Loc["Upgrade.SettingsCardTitle"]</b></MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@Loc["Upgrade.SettingsCardBody"]</MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload" Href="upgrade">
                @Loc["Upgrade.Button"]
            </MudButton>
        </MudStack>
    </MudPaper>
}

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.subtitle1">@(Session.IsLocalMode ? Loc["Offline.LocalAccountTitle"] : Session.UserName)</MudText>
    @if (!Session.IsLocalMode && !string.IsNullOrWhiteSpace(Session.Me?.Email))
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Session.Me!.Email</MudText>
    }
    @if (Session.CurrentCompany is { } company)
    {
        <MudText Typo="Typo.body2" Class="mt-2">
            @company.Name · <b>@Loc[RoleLabels.For(company.Role)]</b>
        </MudText>
    }
</MudPaper>

@if (Session.CurrentCompany is { } currentCompany)
{
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-3">@Loc["Common.Company"]</MudText>
        <div class="settings-company">
            <CompanyLogo @ref="_logo" CompanyId="currentCompany.CompanyId" Size="96" />
            <div class="settings-company-main">
                <MudText Typo="Typo.h6">@currentCompany.Name</MudText>
                @if (CanChangeCompany)
                {
                    <div class="logo-actions">
                        <div>
                            <label for="logo-file" class="attachment-label">@Loc["Logo.ChooseImage"]</label>
                            <InputFile id="logo-file" OnChange="OnLogoSelected" accept="image/jpeg,image/png,image/webp" />
                        </div>
                        <div>
                            <label for="logo-camera" class="attachment-label">@Loc["Attachments.TakePhoto"]</label>
                            <InputFile id="logo-camera" OnChange="OnLogoSelected" accept="image/*" capture="environment" />
                        </div>
                    </div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" Class="mt-2"
                               OnClick="RemoveLogoAsync" Disabled="_busy">@Loc["Logo.Remove"]</MudButton>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">@Loc["Logo.Hint"]</MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@Loc["Settings.CompanyReadOnly"]</MudText>
                }
            </div>
        </div>
        <MudText Typo="Typo.body2" Class="mt-4">@Loc["Calendar.Label"]</MudText>
        <MudRadioGroup T="string" Value="@Session.Calendar().ToString()" ValueChanged="ChangeCalendarAsync" Name="company-calendar"
                       Disabled="@(_busy || !CanChangeCompany)">
            <MudRadio Value="@("BS")" Color="Color.Primary">@Loc["Calendar.Bs"]</MudRadio>
            <MudRadio Value="@("AD")" Color="Color.Primary">@Loc["Calendar.Ad"]</MudRadio>
        </MudRadioGroup>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@Loc["Calendar.Help"]</MudText>
    </MudPaper>
}

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <LanguageSwitcher />
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">@Loc["Settings.LanguageHelp"]</MudText>
    <MudDivider Class="my-3" />
    <MudSwitch T="bool" Value="@Theme.IsDarkMode" ValueChanged="ToggleDarkModeAsync" Color="Color.Primary"
               Label="@Loc["Settings.DarkMode"]" />
</MudPaper>

@if (Backup.IsAvailable && Session.CurrentCompany is { } backupCompany)
{
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-1">@Loc["Backup.Title"]</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">@Loc["Backup.Help"]</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                       Disabled="_busy" OnClick="() => ExportBackupAsync(backupCompany)">
                @Loc["Backup.Export"]
            </MudButton>
            @if (Session.IsLocalMode)
            {
                <div>
                    <label for="backup-restore" class="attachment-label">@Loc["Backup.Restore"]</label>
                    <InputFile id="backup-restore" OnChange="OnRestoreBackupSelected" accept="application/json,.json" />
                </div>
            }
        </MudStack>
    </MudPaper>
}

<MudList T="string" Class="mb-4">
    @* The side menu is hidden on phones, so its other screens are listed here too. *@
    <MudListItem T="string" Icon="@Icons.Material.Filled.ReceiptLong" Href="expenses">@Loc["Nav.Expense"]</MudListItem>
    <MudListItem T="string" Icon="@Icons.Material.Filled.Savings" Href="income">@Loc["Nav.OtherIncome"]</MudListItem>
    @if (!Session.IsLocalMode && Platform.Platform != "Web")
    {
        <MudListItem T="string" Icon="@Icons.Material.Filled.Sync" Href="sync">@Loc["Sync.PageTitle"]</MudListItem>
    }
    @if (!Session.IsLocalMode)
    {
        <MudListItem T="string" Icon="@Icons.Material.Filled.CreditCard" Href="billing">@Loc["Billing.Title"]</MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Filled.Security" Href="settings/security">@Loc["Security.Title"]</MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Filled.UploadFile" Href="import">@Loc["Import.Title"]</MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Filled.Group" Href="staff">@Loc["Settings.Staff"]</MudListItem>
    }
    <MudListItem T="string" Icon="@Icons.Material.Filled.AddBusiness" Href="companies/new">@Loc["Settings.CreateCompany"]</MudListItem>
    @if (!Session.IsLocalMode)
    {
        <MudListItem T="string" Icon="@Icons.Material.Filled.GroupAdd" Href="invite">@Loc["Settings.JoinCompany"]</MudListItem>
    }
</MudList>

<MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout" OnClick="SignOutAsync"
           Disabled="_busy">@(Session.IsLocalMode ? Loc["Offline.LeaveLocal"] : Loc["Settings.SignOut"])</MudButton>
<MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
    @(Session.IsLocalMode ? Loc["Offline.LeaveLocalHelp"] : Platform.Platform == "Web" ? Loc["Settings.SignOutHelpWeb"] : Loc["Settings.SignOutHelpDevice"])
</MudText>

<MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-8">@Loc["Settings.RunningOn", Platform.Platform, Platform.FormFactor]</MudText>

@code {
    private const long MaxLogoBytes = 2L * 1024 * 1024;
    private const long MaxBackupBytes = 20L * 1024 * 1024;

    private static readonly HashSet<string> LogoTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "image/jpeg", "image/png", "image/webp",
    };

    private bool _busy;
    private CompanyLogo? _logo;

    private bool CanChangeCompany => Session.Can(Permission.SettingsBusiness);

    private Task ToggleDarkModeAsync(bool dark) => Theme.SetDarkModeAsync(dark);

    private async Task ExportBackupAsync(CompanySummary company)
    {
        _busy = true;
        try
        {
            var res = await Backup.ExportCompanyJsonAsync(company.CompanyId);
            if (!res.Ok || res.Value is null)
            {
                Snackbar.Add(res.Error ?? Loc["Backup.Failed"], Severity.Error);
                return;
            }

            var safeName = string.Concat(company.Name.Select(ch => char.IsLetterOrDigit(ch) ? ch : '_'));
            var fileName = $"lekhabooks-{safeName}-{DateTime.Today:yyyyMMdd}.json";
            await using var js = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/LekhaBook.UI/js/download.js");
            await js.InvokeVoidAsync("saveJson", fileName, res.Value);
            Snackbar.Add(Loc["Backup.Exported"], Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnRestoreBackupSelected(InputFileChangeEventArgs e)
    {
        _busy = true;
        try
        {
            await using var stream = e.File.OpenReadStream(MaxBackupBytes);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var res = await Backup.ImportCompanyJsonAsync(json);
            if (res.Ok)
            {
                Snackbar.Add(Loc["Backup.Restored", res.Value!.Name], Severity.Success);
            }
            else
            {
                Snackbar.Add(res.Error ?? Loc["Backup.Failed"], Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChangeCalendarAsync(string calendar)
    {
        if (Session.CurrentCompany is not { } company || calendar == Session.Calendar().ToString())
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Companies.UpdateCalendarAsync(company.CompanyId, calendar);
            if (!result.Ok)
            {
                Snackbar.Add(result.Error ?? Loc["Calendar.Failed"], Severity.Error);
                return;
            }

            await Session.RefreshAsync();
            Snackbar.Add(Loc["Calendar.Saved"], Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SignOutAsync()
    {
        _busy = true;
        await Session.SignOutAsync();
    }

    private async Task OnLogoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (Session.CurrentCompany is not { } company)
        {
            return;
        }

        if (!LogoTypes.Contains(file.ContentType))
        {
            Snackbar.Add(Loc["Logo.UnsupportedType"], Severity.Warning);
            return;
        }

        if (file.Size > MaxLogoBytes)
        {
            Snackbar.Add(Loc["Logo.TooLarge", file.Name], Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxLogoBytes);
            var result = await Companies.UploadLogoAsync(company.CompanyId, stream, file.Name, file.ContentType);
            if (result.Ok)
            {
                Snackbar.Add(Loc["Logo.Updated"], Severity.Success);
                if (_logo is not null)
                {
                    await _logo.Refresh();
                }
            }
            else
            {
                Snackbar.Add(result.Error ?? Loc["Logo.Failed"], Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveLogoAsync()
    {
        if (Session.CurrentCompany is not { } company)
        {
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            Loc["Logo.RemoveTitle"], Loc["Logo.RemoveMessage"],
            yesText: Loc["Logo.Remove"], cancelText: Loc["Common.Cancel"]);
        if (confirmed != true)
        {
            return;
        }

        _busy = true;
        var result = await Companies.DeleteLogoAsync(company.CompanyId);
        _busy = false;
        if (result.Ok)
        {
            Snackbar.Add(Loc["Logo.Removed"], Severity.Success);
            if (_logo is not null)
            {
                await _logo.Refresh();
            }
        }
        else
        {
            Snackbar.Add(result.Error ?? Loc["Logo.Failed"], Severity.Error);
        }
    }
}
