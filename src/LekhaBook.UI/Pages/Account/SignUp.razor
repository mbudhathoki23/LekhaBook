@page "/signup"
@layout AuthLayout
@implements IDisposable
@inject ISessionService Session
@inject NavigationManager Navigation
@inject IDeviceUnlock DeviceUnlock
@inject ISnackbar Snackbar

<PageTitle>@Loc["Auth.SignUp.PageTitle"]</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1" tabindex="-1">@Loc["Auth.SignUp.Title"]</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">@Loc["Auth.SignUp.Subtitle"]</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
}

<form @onsubmit="RegisterAsync" @onsubmit:preventDefault="true">
    <MudStack Spacing="3">
        <MudTextField @bind-Value="_name" Label="@Loc["Auth.SignUp.Name"]" Variant="Variant.Outlined" Immediate="true" Required="true"
                      AutoFocus="true" MaxLength="200"
                      UserAttributes="@(new() { ["autocomplete"] = "name", ["enterkeyhint"] = "next" })" />
        <MudTextField @bind-Value="_email" Label="@Loc["Common.Email"]" InputType="InputType.Email" Variant="Variant.Outlined"
                      Immediate="true" Required="true"
                      UserAttributes="@(new() { ["autocomplete"] = "email", ["enterkeyhint"] = "next", ["inputmode"] = "email" })" />
        <MudTextField @bind-Value="_password" Label="@Loc["Common.Password"]" InputType="InputType.Password" Variant="Variant.Outlined"
                      Immediate="true" Required="true"
                      HelperText="@Loc["Auth.SignUp.PasswordHelp"]"
                      UserAttributes="@(new() { ["autocomplete"] = "new-password", ["enterkeyhint"] = "next" })" />
        <MudTextField @bind-Value="_confirm" Label="@Loc["Auth.SignUp.ConfirmPassword"]" InputType="InputType.Password" Variant="Variant.Outlined"
                      Immediate="true" Required="true"
                      UserAttributes="@(new() { ["autocomplete"] = "new-password", ["enterkeyhint"] = "go" })" />
        @if (_deviceState is { Supported: true, Available: true })
        {
            <MudCheckBox T="bool" @bind-Value="_enableDevice" Color="Color.Primary" Label="@Loc["Security.EnableDevice"]" Disabled="_busy" />
        }
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                   FullWidth="true" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            @Loc["Auth.SignUp.Submit"]
        </MudButton>
    </MudStack>
</form>

<MudText Typo="Typo.body2" Class="mt-5" Align="Align.Center">
    @Loc["Auth.SignUp.HavePrompt"] <MudLink Href="@SignInHref">@Loc["Auth.SignUp.SignInLink"]</MudLink>
</MudText>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private string _name = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirm = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _enableDevice;
    private DeviceUnlockState? _deviceState;

    protected override async Task OnInitializedAsync() => _deviceState = await DeviceUnlock.GetStateAsync();

    private string SignInHref => ReturnUrl is { Length: > 0 } r ? $"signin?returnUrl={Uri.EscapeDataString(r)}" : "signin";

    private async Task RegisterAsync()
    {
        if (_busy) return;
        _error = (string.IsNullOrWhiteSpace(_name), string.IsNullOrWhiteSpace(_email), _password.Length < 8, _password != _confirm) switch
        {
            (true, _, _, _) => Loc["Auth.SignUp.NameRequired"].Value,
            (_, true, _, _) => Loc["Auth.SignUp.EmailRequired"].Value,
            (_, _, true, _) => Loc["Auth.SignUp.PasswordTooShort"].Value,
            (_, _, _, true) => Loc["Auth.SignUp.PasswordMismatch"].Value,
            _ => null,
        };
        if (_error is not null)
        {
            return;
        }

        _busy = true;
        var outcome = await Session.RegisterAsync(_name, _email, _password, SignIn.SafeReturnUrl(ReturnUrl));
        _error = outcome.Error;
        _busy = outcome.Ok; // keep the spinner during native opt-in or the web cookie redirect
        if (outcome.Ok && !outcome.HostNavigated)
        {
            _password = _confirm = string.Empty;
            if (_enableDevice && Session.Me is { } me)
            {
                var enabled = await DeviceUnlock.EnableAsync(me.UserId);
                if (!enabled.Succeeded) Snackbar.Add(enabled.Error ?? Loc["Security.DeviceCancelled"], Severity.Warning);
            }
            Navigation.NavigateTo(SignIn.SafeReturnUrl(ReturnUrl));
        }
    }

    public void Dispose() => _password = _confirm = string.Empty;
}
