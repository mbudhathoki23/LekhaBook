@page "/"
@using System.Globalization
@using LekhaBook.Application
@using LekhaBook.Domain
@using LekhaBook.UI.Formatting
@inject IPlatformInfo PlatformInfo
@inject IDataService Data
@inject ICompanyApi Companies
@inject ISessionService Session

<PageTitle>@Loc["Home.Title"] · Lekha Books</PageTitle>

<div class="dashboard">
    <h1 class="dashboard-title" tabindex="-1">@Loc["Home.Title"]</h1>

    @if (_error is not null)
    {
        <LoadError Message="@_error.Error" Offline="_error.IsNetworkError" What="@Loc["Home.Totals"]" OnRetry="LoadAsync" />
    }

    <section class="balance-grid" aria-label="@Loc["Home.Totals"]">
        @foreach (var tile in Tiles)
        {
            <a class="balance-tile @tile.Tone" href="@tile.Href">
                <span class="balance-label">
                    <span class="balance-icon"><MudIcon Icon="@tile.Icon" Size="Size.Small" aria-hidden="true" /></span>
                    <span>@tile.Label</span>
                </span>
                <strong class="balance-value">@(tile.Amount is { } amount ? Money.Format(amount) : "—")</strong>
            </a>
        }
    </section>

    <section aria-labelledby="quick-entry-heading">
        <h2 class="dashboard-section-title" id="quick-entry-heading">@Loc["Home.QuickEntry"]</h2>
        <div class="quick-entry">
            @foreach (var entry in QuickEntries)
            {
                <MudButton Class="@($"entry-shortcut {entry.Tone}")" Variant="Variant.Outlined" Href="@($"transactions/new?type={entry.Type}")"
                           Disabled="@(!CanAdd(entry.Type))">
                    <span class="shortcut-icon"><MudIcon Icon="@entry.Icon" Size="Size.Small" aria-hidden="true" /></span>
                    <span>@Loc[entry.LabelKey]</span>
                </MudButton>
            }
        </div>
    </section>

    @if (_dashboard is { Months.Count: > 0 } dashboard)
    {
        <section class="dashboard-panel" aria-labelledby="month-totals-heading">
            <h2 class="dashboard-section-title" id="month-totals-heading">@Loc["Home.ThisMonth"] <span>· @MonthLabel(dashboard.Months[^1])</span></h2>
            <dl class="month-totals">
                <div class="incoming">
                    <dt>@Loc["Home.MoneyIn"]</dt>
                    <dd>@Money.Format(dashboard.ThisMonth.MoneyIn)</dd>
                </div>
                <div class="outgoing">
                    <dt>@Loc["Home.MoneyOut"]</dt>
                    <dd>@Money.Format(dashboard.ThisMonth.MoneyOut)</dd>
                </div>
                <div>
                    <dt>@Loc["Home.Net"]</dt>
                    <dd>@Money.Format(dashboard.ThisMonth.Net)</dd>
                </div>
            </dl>
        </section>

        <div class="dashboard-reports">
            <section class="dashboard-panel" aria-labelledby="monthly-report-heading">
                <h2 class="dashboard-section-title" id="monthly-report-heading">@Loc["Home.Monthly"]</h2>
                <p class="report-hint">@Loc["Home.MonthlyHint"]</p>
                @if (dashboard.ActiveMonths.Count == 0)
                {
                    <p class="report-empty">@Loc["Home.FlowsEmpty"]</p>
                }
                else
                {
                    <FlowBars Rows="@MonthRows(dashboard)" />
                }
            </section>

            <section class="dashboard-panel" aria-labelledby="yearly-report-heading">
                <h2 class="dashboard-section-title" id="yearly-report-heading">@Loc["Home.Yearly"]</h2>
                <p class="report-hint">@Loc["Home.YearlyHint"]</p>
                @if (dashboard.ActiveFiscalYears.Count == 0)
                {
                    <p class="report-empty">@Loc["Home.FlowsEmpty"]</p>
                }
                else
                {
                    <FlowBars Rows="@YearRows(dashboard)" />
                }
            </section>
        </div>

        <section class="dashboard-panel" aria-labelledby="top-parties-heading">
            <h2 class="dashboard-section-title" id="top-parties-heading">@Loc["Home.TopParties"]</h2>
            <p class="report-hint">@Loc["Home.TopPartiesHint"]</p>
            @if (dashboard.TopParties.Count == 0)
            {
                <p class="report-empty">@Loc["Home.FlowsEmpty"]</p>
            }
            else
            {
                <div class="flow-list">
                    @foreach (var party in dashboard.TopParties)
                    {
                        <a class="flow-row flow-link" href="@($"parties/{party.PartyId}")">
                            <div class="flow-head">
                                <span class="flow-label">@party.Name</span>
                                <span class="flow-net">@BalanceText(party.Balance)</span>
                            </div>
                            <div class="flow-track">
                                <div class="flow-area" aria-hidden="true"><div class="flow-bar party" style="width: @Share(party.Total, dashboard.TopParties[0].Total)%"></div></div>
                                <span class="flow-value">@Loc["Home.Business"] @Money.Format(party.Total)</span>
                            </div>
                        </a>
                    }
                </div>
            }
        </section>

        <p class="dashboard-note">@Loc["Home.FlowsNote"]</p>
    }
    else if (_loading && Session.Can(Permission.ReportsDashboard))
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@Loc["Shell.Loading"]" />
    }

    <p class="dashboard-note">@Loc["Settings.RunningOn", PlatformInfo.Platform, PlatformInfo.FormFactor]</p>
</div>

@code {
    private List<PartyDto>? _parties;
    private List<MoneyAccountDto>? _accounts;
    private DashboardReport? _dashboard;
    private CalendarMode _calendar;
    private ApiError? _error;
    private bool _loading = true;

    private static readonly (TransactionType Type, string LabelKey, string Icon, string Tone)[] QuickEntries =
    [
        (TransactionType.PaymentIn, "TxnType.PaymentIn", Icons.Material.Filled.CallReceived, "incoming"),
        (TransactionType.PaymentOut, "TxnType.PaymentOut", Icons.Material.Filled.CallMade, "outgoing"),
        (TransactionType.Expense, "Transactions.Type.Expense", Icons.Material.Filled.ReceiptLong, ""),
        (TransactionType.OtherIncome, "TxnType.OtherIncome", Icons.Material.Filled.Savings, ""),
        (TransactionType.TransferMoney, "TxnType.TransferMoney", Icons.Material.Filled.SwapHoriz, ""),
    ];

    private IEnumerable<(string Label, decimal? Amount, string Icon, string Tone, string Href)> Tiles =>
    [
        (Loc["PartySide.ToReceive"], _parties?.Where(p => p.Balance > 0).Sum(p => p.Balance),
            Icons.Material.Filled.CallReceived, "incoming", "parties?balance=receive"),
        (Loc["PartySide.ToGive"], _parties is null ? null : -_parties.Where(p => p.Balance < 0).Sum(p => p.Balance),
            Icons.Material.Filled.CallMade, "outgoing", "parties?balance=give"),
        (Loc["Home.CashInHand"], _accounts?.Where(a => a.Type == "Cash").Sum(a => a.Balance),
            Icons.Material.Filled.Payments, "", "accounts"),
        (Loc["Home.BankBalance"], _accounts?.Where(a => a.Type == "Bank").Sum(a => a.Balance),
            Icons.Material.Filled.AccountBalance, "", "accounts"),
    ];

    private bool CanAdd(TransactionType type) => Session.Can(EntryRules.PermissionFor(type, EntryAction.Create));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (Session.CurrentCompany is not { } company)
        {
            return;
        }

        _error = null;
        _loading = true;
        if (Session.Can(Permission.CustomersView) || Session.Can(Permission.SuppliersView))
        {
            var parties = await Data.GetPartiesAsync(company.CompanyId);
            _parties = parties.Value;
            _error ??= parties.Ok ? null : new ApiError(parties.Error, parties.IsNetworkError);
        }

        if (Session.Can(Permission.AccountsView))
        {
            var accounts = await Data.GetMoneyAccountsAsync(company.CompanyId);
            _accounts = accounts.Value;
            _error ??= accounts.Ok ? null : new ApiError(accounts.Error, accounts.IsNetworkError);
        }

        if (Session.Can(Permission.ReportsDashboard))
        {
            await LoadDashboardAsync(company.CompanyId);
        }

        _loading = false;
    }

    private async Task LoadDashboardAsync(Guid companyId)
    {
        var details = await Companies.GetCompanyAsync(companyId);
        var transactions = await Data.GetTransactionsAsync(companyId);
        _error ??= details.Ok ? null : new ApiError(details.Error, details.IsNetworkError);
        _error ??= transactions.Ok ? null : new ApiError(transactions.Error, transactions.IsNetworkError);
        if (details.Value is not { } settings || transactions.Value is not { } entries)
        {
            _dashboard = null;
            return;
        }

        _calendar = Enum.TryParse(settings.Calendar, out CalendarMode calendar) ? calendar : CalendarMode.BS;
        _dashboard = DashboardFlows.Build(
            entries,
            _parties ?? [],
            _calendar,
            settings.FiscalYearStartMonth,
            CompanyClock.Today(settings.TimeZoneId, TimeProvider.System));
    }

    private string MonthLabel(MonthFlow month)
    {
        if (_calendar == CalendarMode.AD)
        {
            return new DateOnly(month.Year, month.Month, 1).ToString("MMM yyyy", CultureInfo.CurrentUICulture);
        }

        var monthKey = $"Calendar.Month{month.Month}";
        return $"{Loc[monthKey].Value} {month.Year}";
    }

    private static string FiscalYearLabel(int startYear) => $"{startYear}/{(startYear + 1) % 100:00}";

    private IReadOnlyList<(string Label, FlowTotals Totals)> MonthRows(DashboardReport report) =>
        report.ActiveMonths.Select(m => (MonthLabel(m), m.Totals)).ToList();

    private static IReadOnlyList<(string Label, FlowTotals Totals)> YearRows(DashboardReport report) =>
        report.ActiveFiscalYears.Select(y => (FiscalYearLabel(y.StartYear), y.Totals)).ToList();

    private string BalanceText(decimal balance)
    {
        var (labelKey, _) = MasterLabels.PartySide(balance);
        return balance == 0 ? Loc[labelKey].Value : $"{Loc[labelKey].Value} {Money.Format(Math.Abs(balance))}";
    }

    private static string Share(decimal value, decimal largest) =>
        largest <= 0m ? "0" : (value / largest * 100m).ToString("0.##", CultureInfo.InvariantCulture);

    private sealed record ApiError(string? Error, bool IsNetworkError);
}
