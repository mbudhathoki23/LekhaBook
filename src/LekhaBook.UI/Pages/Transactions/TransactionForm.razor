@page "/transactions/new"
@page "/transactions/{TransactionId:guid}/edit"
@using LekhaBook.Application
@using LekhaBook.Domain
@inject IDataService Data
@inject ISessionService Session
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IAttachmentService Attachments
@inject AttachmentContentCache Cache

<PageTitle>@Title · Lekha Books</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3" tabindex="-1">@Title</MudText>

@if (_loadError is not null)
{
    <LoadError Message="@_loadError" Offline="_offline" What="@Loc["Transactions.List.Title"]" OnRetry="LoadAsync" />
}
else if (!_loaded)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else if (IsNew && OfferedTypes.Count == 0)
{
    <MudAlert Severity="Severity.Info">@Loc["Transactions.Form.NoCreatePermission"]</MudAlert>
}
else if (_existing is not null && (_existing.Status == "Void" || !FormTypes.Contains(_type)))
{
    <MudAlert Severity="Severity.Info" Class="mb-3">
        @(_existing.Status == "Void" ? Loc["Transactions.Form.VoidedNotice"] : Loc["Transactions.Form.NotEditableHere"])
    </MudAlert>
    <MudText Class="mb-3">@Loc[MasterLabels.TransactionType(_existing.Type)] · @Session.FormatDate(_existing.Date) · @Money.Format(_existing.Amount)</MudText>
    <MudButton Variant="Variant.Text" Href="transactions">@Loc["Transactions.Form.BackToList"]</MudButton>
    @if (CanVoid && _existing.Status != "Void")
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="VoidAsync" Disabled="_saving">@Loc["Transactions.Form.VoidEntry"]</MudButton>
    }
}
else
{
    <EnterNavForm @ref="_form" Class="entry-form">
        <MudPaper Class="pa-4 mb-3" Elevation="1">
            @if (IsNew)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@Loc["Transactions.Form.TypeLabel"]</MudText>
                <MudRadioGroup T="TransactionType" Value="_type" ValueChanged="ChangeType" Name="transaction-type">
                    @foreach (var type in OfferedTypes)
                    {
                        <MudRadio Value="@type" Color="Color.Primary">@Label(type)</MudRadio>
                    }
                </MudRadioGroup>
            }

            <DateField @ref="_dateField" @bind-Value="_date" Label="@Loc["Common.Date"]" Class="mt-2" Disabled="DateLocked"
                       HelperText="@(DateLocked ? Loc["Transactions.Form.DateLockedHelp"].Value : null)"
                       Error="@Has("date")" ErrorText="@ErrorOf("date")" />

            <MudAutocomplete T="Choice" @bind-Value="_first" Label="@($"{FirstLabel} *")" SearchFunc="SearchFirst"
                             ToStringFunc="c => c?.Name" OpenOnFocus="false" SelectOnActivation="false" Clearable="true"
                             ResetValueOnEmptyText="true" Variant="Variant.Outlined" Class="mt-3"
                             HelperText="@BalanceText(_first)" Error="@Has(FirstKey)" ErrorText="@ErrorOf(FirstKey)">
                <ItemTemplate Context="choice">@ItemText(choice)</ItemTemplate>
            </MudAutocomplete>

            <MudNumericField T="decimal?" @bind-Value="_amount" Label="@Loc["Transactions.Form.AmountLabel"]" Placeholder="0" HideSpinButtons="true"
                             InputMode="InputModes.Decimal" Variant="Variant.Outlined" Class="mt-3"
                             Error="@Has("amount")" ErrorText="@ErrorOf("amount")" />

            <MudAutocomplete T="Choice" @bind-Value="_second" Label="@($"{SecondLabel} *")" SearchFunc="SearchSecond"
                             ToStringFunc="c => c?.Name" OpenOnFocus="false" SelectOnActivation="false" Clearable="true"
                             ResetValueOnEmptyText="true" Variant="Variant.Outlined" Class="mt-3"
                             HelperText="@BalanceText(_second)" Error="@Has(SecondKey)" ErrorText="@ErrorOf(SecondKey)">
                <ItemTemplate Context="choice">@ItemText(choice)</ItemTemplate>
            </MudAutocomplete>

            @if (ShowCheque)
            {
                <MudTextField @bind-Value="_chequeNo" Label="@Loc["Transactions.Form.ChequeNoLabel"]" Variant="Variant.Outlined" Class="mt-3"
                              MaxLength="MasterValidation.ChequeNoMax" Error="@Has("chequeNo")" ErrorText="@ErrorOf("chequeNo")" />
                <DateField @ref="_chequeDateField" @bind-Value="_chequeDate" Label="@Loc["Transactions.Form.ChequeDateLabel"]" Class="mt-3" />
            }

            <MudTextField @bind-Value="_remarks" Label="@Loc["Common.Remarks"]" Variant="Variant.Outlined" Class="mt-3"
                          MaxLength="MasterValidation.RemarksMax" Error="@Has("remarks")" ErrorText="@ErrorOf("remarks")" />
        </MudPaper>

        <MudPaper Class="pa-4 mb-3" Elevation="1">
            <MudText Typo="Typo.subtitle2" Class="mb-2">@Loc["Transactions.Form.Attachments"]</MudText>
            @if (IsNew && _staged.Count > 0)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">@Loc["Attachments.SavedWithEntry"]</MudText>
                @foreach (var staged in _staged)
                {
                    <div class="attachment-row">
                        <div class="attachment-info">
                            <MudText Typo="Typo.body2" Class="attachment-name">@staged.Name</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@FileSize(staged.Size)</MudText>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Disabled="_uploading"
                                       aria-label="@Loc["Attachments.RemoveNamed", staged.Name]" OnClick="() => RemoveStaged(staged)" />
                    </div>
                }
            }
            @foreach (var attachment in _attachments)
            {
                <div class="attachment-row" @key="attachment.Id">
                    <AttachmentImage CompanyId="CurrentCompanyId" Attachment="attachment" Size="72" />
                    <div class="attachment-info">
                        <MudText Typo="Typo.body2" Class="attachment-name">@attachment.FileName</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@FileSize(attachment.SizeBytes)</MudText>
                    </div>
                    @if (CanEdit)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Disabled="_uploading"
                                       aria-label="@Loc["Attachments.RemoveNamed", attachment.FileName]" OnClick="() => DeleteAttachmentAsync(attachment)" />
                    }
                </div>
            }
            @if (IsNew || CanEdit)
            {
                <div class="attachment-pickers">
                    <div>
                        <label for="attachment-files" class="attachment-label">@Loc["Attachments.ChooseFiles"]</label>
                        <InputFile id="attachment-files" OnChange="OnFilesSelected" multiple
                                   accept="image/jpeg,image/png,image/webp,application/pdf" aria-label="@Loc["Transactions.Form.AddAttachments"]" />
                    </div>
                    <div>
                        <label for="attachment-camera" class="attachment-label">@Loc["Attachments.TakePhoto"]</label>
                        <InputFile id="attachment-camera" OnChange="OnFilesSelected" accept="image/*" capture="environment" />
                    </div>
                </div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">@Loc["Transactions.Form.AttachmentLimits"]</MudText>
            }
            @if (_uploading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-2" />
            }
        </MudPaper>

        @if (_saveError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" role="alert">@_saveError</MudAlert>
        }

        <div class="form-actions">
            <MudButton Variant="Variant.Text" Href="transactions" data-enter-cancel>@Loc["Common.Cancel"]</MudButton>
            @if (!IsNew && CanVoid)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="VoidAsync" Disabled="_saving">@Loc["Transactions.Form.VoidEntry"]</MudButton>
            }
            @if (IsNew)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => SaveAsync(andNew: true))" Disabled="_saving">@Loc["Transactions.Form.SaveAndNew"]</MudButton>
            }
            @if (IsNew || CanEdit)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SaveAsync(andNew: false))" Disabled="_saving" data-enter-save>
                    @(_saving ? Loc["Transactions.Form.Saving"] : Loc["Common.Save"])
                </MudButton>
            }
        </div>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2 keyboard-hint">
            @Loc["Transactions.Form.KeyboardHint"]
        </MudText>
    </EnterNavForm>
}

@code {
    /// <summary>The entry types this form can record. Add/Reduce Money and party adjustments get their own screens.</summary>
    private static readonly TransactionType[] FormTypes =
    [
        TransactionType.PaymentIn, TransactionType.PaymentOut, TransactionType.Expense,
        TransactionType.OtherIncome, TransactionType.TransferMoney,
    ];

    private const int MaxAttachments = 5;
    private const long MaxFileBytes = 5L * 1024 * 1024;

    /// <summary>What the server accepts (HEIC isn't).</summary>
    private static readonly HashSet<string> AllowedTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "image/jpeg", "image/png", "image/webp", "application/pdf",
    };

    private EnterNavForm? _form;
    private bool _loaded;
    private string? _loadError;
    private bool _offline;
    private string? _saveError;
    private bool _saving;
    private bool _uploading;
    private Dictionary<string, string[]> _errors = [];

    private List<PartyDto> _parties = [];
    private List<MoneyAccountDto> _accounts = [];
    private List<CategoryDto> _categories = [];
    private List<AttachmentDto> _attachments = [];
    /// <summary>Files chosen for a new entry; uploaded once it saves.</summary>
    private readonly List<StagedFile> _staged = [];
    private TransactionDto? _existing;

    private TransactionType _type = TransactionType.PaymentIn;
    private Choice? _first;  // party, category or "from" account
    private Choice? _second; // payment method or "to" account
    private decimal? _amount;
    private DateTime? _date = DateTime.Today;
    private string? _remarks;
    private string? _chequeNo;
    private DateTime? _chequeDate;
    private DateField? _dateField;
    private DateField? _chequeDateField;

    /// <summary>Kept until a save succeeds, so pressing Save again after a lost reply can't add the entry twice.</summary>
    private Guid _newId = Guid.CreateVersion7();

    [Parameter]
    public Guid? TransactionId { get; set; }

    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeQuery { get; set; }

    private bool IsNew => TransactionId is null;

    private Guid CurrentCompanyId => Session.CurrentCompany?.CompanyId ?? Guid.Empty;

    /// <summary>Attachments on the entry, or files staged for a new one.</summary>
    private int AttachmentCount => IsNew ? _staged.Count : _attachments.Count;

    private string Title => IsNew ? Loc["Transactions.Add"] : Loc["Transactions.Form.EditTitle", Label(_type)];

    private List<TransactionType> OfferedTypes =>
        FormTypes.Where(t => Session.Can(EntryRules.PermissionFor(t, EntryAction.Create))).ToList();

    private bool CanEdit => Session.Can(EntryRules.PermissionFor(_type, EntryAction.Edit));

    private bool CanVoid => Session.Can(EntryRules.PermissionFor(_type, EntryAction.Delete));

    private bool DateLocked => Session.Can(Permission.RestrictLockDate);

    /// <summary>The money side is "From" when money leaves: Payment Out and Expense.</summary>
    private bool MoneyIsFrom => _type is TransactionType.PaymentOut or TransactionType.Expense;

    private string FirstLabel => _type switch
    {
        TransactionType.PaymentIn or TransactionType.PaymentOut => Loc["Common.Party"],
        TransactionType.Expense or TransactionType.OtherIncome => Loc["Common.Category"],
        _ => Loc["Transactions.Form.FromAccount"],
    };

    private string SecondLabel => _type == TransactionType.TransferMoney
        ? Loc["Transactions.Form.ToAccount"]
        : Loc["Transactions.Form.PaymentMethod"];

    private string FirstKey => MoneyIsFrom ? "toAccountId" : "fromAccountId";

    private string SecondKey => MoneyIsFrom ? "fromAccountId" : "toAccountId";

    private bool ShowCheque =>
        !string.IsNullOrEmpty(_chequeNo)
        || _accounts.Any(a => a.Type == "Cheque" && (a.Id == _second?.Id || (_type == TransactionType.TransferMoney && a.Id == _first?.Id)));

    /// <summary>Choices for one side of the entry, from what the posting rules allow there.</summary>
    private IEnumerable<Choice> ChoicesFor(PostingRules.AccountRole role) => role switch
    {
        PostingRules.AccountRole.Party => _parties.Select(p => new Choice(p.Id, p.Name, p.Balance, IsParty: true)),
        PostingRules.AccountRole.Money => _accounts.Select(a => new Choice(a.Id, a.Name, a.Balance)),
        PostingRules.AccountRole.Income => _categories.Where(c => c.Type == "Income").Select(c => new Choice(c.Id, c.Name)),
        PostingRules.AccountRole.Expense => _categories.Where(c => c.Type == "Expense").Select(c => new Choice(c.Id, c.Name)),
        _ => [],
    };

    private IEnumerable<Choice> FirstChoices =>
        ChoicesFor(MoneyIsFrom ? PostingRules.RolesFor(_type).To : PostingRules.RolesFor(_type).From);

    private IEnumerable<Choice> SecondChoices =>
        ChoicesFor(MoneyIsFrom ? PostingRules.RolesFor(_type).From : PostingRules.RolesFor(_type).To);

    private bool Has(string key) => _errors.ContainsKey(key);

    private string? ErrorOf(string key) => _errors.TryGetValue(key, out var e) ? string.Join(" ", e) : null;

    private string Label(TransactionType type) => Loc[MasterLabels.TransactionType(type.ToString())];

    /// <summary>The balance without its "Balance:" prefix, e.g. "Rs. 500" or "Rs. 500 To Receive" for a party.</summary>
    private string? BalanceDetail(Choice? choice) => choice?.Balance is not { } balance ? null
        : !choice.IsParty ? Money.Format(balance)
        : $"{Money.Format(Math.Abs(balance))} {Loc[MasterLabels.PartySide(balance).LabelKey]}";

    private string? BalanceText(Choice? choice) =>
        BalanceDetail(choice) is { } detail ? Loc["Transactions.Form.Balance", detail].Value : null;

    private string ItemText(Choice choice) =>
        BalanceDetail(choice) is { } detail ? $"{choice.Name} · {detail}" : choice.Name;

    private string FileSize(long bytes) =>
        bytes < 1024 ? Loc["Transactions.Attachment.SizeBytes", bytes]
        : bytes < 1024 * 1024 ? Loc["Transactions.Attachment.SizeKb", bytes / 1024]
        : Loc["Transactions.Attachment.SizeMb", bytes / (1024 * 1024)];

    private Task<IEnumerable<Choice>> SearchFirst(string? text, CancellationToken cancellationToken) => Search(FirstChoices, text);

    private Task<IEnumerable<Choice>> SearchSecond(string? text, CancellationToken cancellationToken) => Search(SecondChoices, text);

    private static Task<IEnumerable<Choice>> Search(IEnumerable<Choice> choices, string? text) =>
        Task.FromResult(string.IsNullOrWhiteSpace(text)
            ? choices
            : choices.Where(c => c.Name.Contains(text.Trim(), StringComparison.CurrentCultureIgnoreCase)));

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (Session.CurrentCompany is not { } company)
        {
            return;
        }

        _loaded = false;
        _loadError = null;
        _existing = null;

        if (Session.Can(Permission.CustomersView) || Session.Can(Permission.SuppliersView))
        {
            var parties = await Data.GetPartiesAsync(company.CompanyId);
            if (!Loaded(parties))
            {
                return;
            }

            _parties = parties.Value!;
        }

        if (Session.Can(Permission.AccountsView))
        {
            var accounts = await Data.GetMoneyAccountsAsync(company.CompanyId);
            if (!Loaded(accounts))
            {
                return;
            }

            _accounts = accounts.Value!;
        }

        if (Session.Can(Permission.IncomeExpenseView))
        {
            var categories = await Data.GetCategoriesAsync(company.CompanyId);
            if (!Loaded(categories))
            {
                return;
            }

            _categories = categories.Value!;
        }

        if (TransactionId is { } id)
        {
            var transaction = await Data.GetTransactionAsync(company.CompanyId, id);
            if (!Loaded(transaction))
            {
                return;
            }

            Show(transaction.Value!);
            var attachments = await Attachments.GetAttachmentsAsync(company.CompanyId, id);
            _attachments = attachments.Value ?? [];
        }
        else
        {
            var wanted = MasterValidation.ParseTransactionType(TypeQuery);
            var offered = OfferedTypes;
            _type = wanted is { } w && offered.Contains(w) ? w : offered.FirstOrDefault();
            (_first, _amount, _remarks, _chequeNo, _chequeDate, _saveError) = (null, null, null, null, null, null);
            _errors = [];
            _staged.Clear();
            _date = DateTime.Today;
            _second = DefaultSecond();
        }

        _loaded = true;
    }

    private bool Loaded<T>(ApiResult<T> result)
    {
        if (!result.Ok)
        {
            (_loadError, _offline) = (result.Error, result.IsNetworkError);
        }

        return result.Ok;
    }

    private void Show(TransactionDto existing)
    {
        _existing = existing;
        _type = MasterValidation.ParseTransactionType(existing.Type)!.Value;
        _amount = existing.Amount;
        _date = existing.Date.ToDateTime(TimeOnly.MinValue);
        _remarks = existing.Remarks;
        _chequeNo = existing.ChequeNo;
        _chequeDate = existing.ChequeDate?.ToDateTime(TimeOnly.MinValue);
        if (!FormTypes.Contains(_type))
        {
            return;
        }

        var (firstId, secondId) = MoneyIsFrom
            ? (existing.ToAccountId, existing.FromAccountId)
            : (existing.FromAccountId, existing.ToAccountId);
        _first = FirstChoices.FirstOrDefault(c => c.Id == firstId);
        _second = SecondChoices.FirstOrDefault(c => c.Id == secondId);
    }

    /// <summary>The first money account (Cash) for a payment method; a transfer's destination is left to choose.</summary>
    private Choice? DefaultSecond() => _type == TransactionType.TransferMoney ? null : SecondChoices.FirstOrDefault();

    private void ChangeType(TransactionType type)
    {
        var method = _type == TransactionType.TransferMoney ? null : _second;
        _type = type;
        _first = null;
        _second = type == TransactionType.TransferMoney ? null : method ?? DefaultSecond();
        _errors = [];
    }

    private async Task SaveAsync(bool andNew)
    {
        if (Session.CurrentCompany is not { } company || _saving)
        {
            return;
        }

        _saveError = null;
        var first = _first?.Id ?? Guid.Empty;
        var second = _second?.Id ?? Guid.Empty;
        var (from, to) = MoneyIsFrom ? (second, first) : (first, second);
        var date = _date is { } d ? DateOnly.FromDateTime(d) : (DateOnly?)null;
        var chequeDate = ShowCheque && _chequeDate is { } cd ? DateOnly.FromDateTime(cd) : (DateOnly?)null;
        var chequeNo = ShowCheque ? _chequeNo : null;

        // A new entry left on this device's today sends no date, so the server uses the company's today (D12).
        var create = new CreateTransactionRequest(
            _type.ToString(), DateLocked || _date == DateTime.Today ? null : date, _amount ?? 0, from, to,
            _remarks, chequeNo, chequeDate, _newId);
        _errors = MasterValidation.Validate(create, Loc.ForValidation());
        if (!IsNew && date is null)
        {
            _errors["date"] = [Loc["Transactions.Form.DateRequired"]];
        }

        // An unreadable miti must not fall back to the date the field held before.
        if (_dateField?.IsInvalid == true)
        {
            _errors["date"] = [Loc["Calendar.InvalidBs"]];
        }

        if (ShowCheque && _chequeDateField?.IsInvalid == true)
        {
            _errors["chequeDate"] = [Loc["Calendar.InvalidBs"]];
        }

        if (_errors.Count > 0)
        {
            _form?.FocusFirstErrorAfterRender();
            return;
        }

        _saving = true;
        try
        {
            var result = IsNew
                ? await Data.AddTransactionAsync(company.CompanyId, create)
                : await Data.UpdateTransactionAsync(company.CompanyId, TransactionId!.Value,
                    new UpdateTransactionRequest(date!.Value, _amount!.Value, from, to, _remarks, chequeNo, chequeDate));
            if (!result.Ok)
            {
                _saveError = result.Error;
                return;
            }

            Snackbar.Add(Loc["Transactions.Form.SavedSnackbar", Label(_type), Money.Format(result.Value!.Amount)], Severity.Success);
            if (IsNew && _staged.Count > 0)
            {
                // The entry is saved; the files go to it before this page navigates away or resets.
                await UploadStagedAsync(company.CompanyId, result.Value!.Id);
            }

            if (!andNew)
            {
                Navigation.NavigateTo("transactions");
                return;
            }

            // Save & New keeps the type, date and payment method (plan § 8.4); balances are reloaded.
            _newId = Guid.CreateVersion7();
            (_first, _amount, _remarks, _chequeNo, _chequeDate) = (null, null, null, null, null);
            await ReloadBalancesAsync(company.CompanyId);
            StateHasChanged();
            if (_form is not null)
            {
                await _form.FocusFirstAsync();
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ReloadBalancesAsync(Guid companyId)
    {
        if (Session.Can(Permission.CustomersView) || Session.Can(Permission.SuppliersView))
        {
            _parties = (await Data.GetPartiesAsync(companyId)).Value ?? _parties;
        }

        if (Session.Can(Permission.AccountsView))
        {
            _accounts = (await Data.GetMoneyAccountsAsync(companyId)).Value ?? _accounts;
            _second = _second is null ? null : SecondChoices.FirstOrDefault(c => c.Id == _second.Id);
        }
    }

    private async Task VoidAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            Loc["Transactions.Form.VoidTitle"],
            Loc["Transactions.Form.VoidMessage"],
            yesText: Loc["Transactions.Form.VoidEntry"], cancelText: Loc["Common.Cancel"]);
        if (confirmed != true || Session.CurrentCompany is not { } company || TransactionId is not { } id)
        {
            return;
        }

        _saving = true;
        var result = await Data.DeleteTransactionAsync(company.CompanyId, id);
        _saving = false;
        if (result.Ok)
        {
            Snackbar.Add(Loc["Transactions.Form.VoidedSnackbar"], Severity.Success);
            Navigation.NavigateTo("transactions");
        }
        else
        {
            Snackbar.Add(result.Error ?? Loc["Transactions.Form.GenericError"], Severity.Error);
        }
    }

    /// <summary>The picker and the camera both come here. A new entry keeps the files until it saves; a saved entry uploads them now.</summary>
    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        if (Session.CurrentCompany is not { } company || _uploading)
        {
            return;
        }

        // GetMultipleFiles throws past its limit, so a bigger pick is refused as a whole.
        if (e.FileCount > MaxAttachments)
        {
            Snackbar.Add(Loc["Transactions.Form.AttachmentMax"], Severity.Warning);
            return;
        }

        var accepted = new List<IBrowserFile>();
        foreach (var file in e.GetMultipleFiles(MaxAttachments))
        {
            if (!AllowedTypes.Contains(file.ContentType))
            {
                Snackbar.Add(Loc["Attachments.UnsupportedType", file.Name], Severity.Warning);
            }
            else if (file.Size > MaxFileBytes)
            {
                Snackbar.Add(Loc["Transactions.Form.FileTooLarge", file.Name], Severity.Warning);
            }
            else
            {
                accepted.Add(file);
            }
        }

        if (accepted.Count == 0)
        {
            return;
        }

        // The same limit the server applies: existing attachments plus the new ones.
        if (AttachmentCount + accepted.Count > MaxAttachments)
        {
            Snackbar.Add(Loc["Transactions.Form.AttachmentMax"], Severity.Warning);
            return;
        }

        _uploading = true;
        try
        {
            if (IsNew)
            {
                foreach (var file in accepted)
                {
                    _staged.Add(await ReadStagedAsync(file));
                }

                return;
            }

            if (TransactionId is { } id)
            {
                await UploadFilesAsync(company.CompanyId, id, accepted);
            }
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task UploadFilesAsync(Guid companyId, Guid transactionId, IEnumerable<IBrowserFile> files)
    {
        foreach (var file in files)
        {
            await using var stream = file.OpenReadStream(MaxFileBytes);
            var result = await Attachments.UploadAttachmentAsync(companyId, stream, file.Name, file.ContentType, transactionId);
            Snackbar.Add(result.Ok ? Loc["Transactions.Form.Uploaded", file.Name] : Loc["Transactions.Form.UploadFailed", result.Error ?? string.Empty],
                result.Ok ? Severity.Success : Severity.Error);
        }

        var reloaded = await Attachments.GetAttachmentsAsync(companyId, transactionId);
        _attachments = reloaded.Value ?? _attachments;
    }

    private static async Task<StagedFile> ReadStagedAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(MaxFileBytes);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        return new StagedFile(file.Name, file.ContentType, memory.ToArray());
    }

    /// <summary>Uploads the files a new entry was saved with. The entry is already saved, so a failure only warns.</summary>
    private async Task UploadStagedAsync(Guid companyId, Guid transactionId)
    {
        _uploading = true;
        var failed = new List<string>();
        try
        {
            foreach (var staged in _staged)
            {
                using var stream = new MemoryStream(staged.Content);
                var result = await Attachments.UploadAttachmentAsync(companyId, stream, staged.Name, staged.ContentType, transactionId);
                if (!result.Ok)
                {
                    failed.Add(staged.Name);
                }
            }
        }
        finally
        {
            _staged.Clear();
            _uploading = false;
        }

        if (failed.Count > 0)
        {
            Snackbar.Add(Loc["Attachments.NotUploaded", string.Join(", ", failed)], Severity.Warning);
        }
    }

    private void RemoveStaged(StagedFile staged) => _staged.Remove(staged);

    private async Task DeleteAttachmentAsync(AttachmentDto attachment)
    {
        if (Session.CurrentCompany is not { } company || TransactionId is not { } id || _uploading)
        {
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            Loc["Attachments.DeleteTitle"],
            Loc["Attachments.DeleteMessage", attachment.FileName],
            yesText: Loc["Common.Delete"], cancelText: Loc["Common.Cancel"]);
        if (confirmed != true)
        {
            return;
        }

        _uploading = true;
        try
        {
            var result = await Attachments.DeleteAttachmentAsync(company.CompanyId, attachment.Id);
            if (!result.Ok)
            {
                Snackbar.Add(result.Error ?? Loc["Attachments.DeleteFailed"], Severity.Error);
                return;
            }

            Cache.Invalidate(company.CompanyId, attachment.Id);
            Snackbar.Add(Loc["Attachments.Deleted", attachment.FileName], Severity.Success);
            _attachments = _attachments.Where(a => a.Id != attachment.Id).ToList();
            var reloaded = await Attachments.GetAttachmentsAsync(company.CompanyId, id);
            if (reloaded.Ok)
            {
                _attachments = reloaded.Value!;
            }
        }
        finally
        {
            _uploading = false;
        }
    }

    private sealed record Choice(Guid Id, string Name, decimal? Balance = null, bool IsParty = false);

    /// <summary>A file held in memory until its entry saves.</summary>
    private sealed record StagedFile(string Name, string ContentType, byte[] Content)
    {
        public long Size => Content.LongLength;
    }
}
