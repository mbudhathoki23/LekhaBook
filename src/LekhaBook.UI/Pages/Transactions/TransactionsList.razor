@page "/transactions"
@using LekhaBook.Domain
@using LekhaBook.UI.Formatting
@inject IDataService Data
@inject ISessionService Session
@inject NavigationManager Navigation

<PageTitle>@Loc["Transactions.List.Title"] · Lekha Books</PageTitle>

<div class="page-header">
    <MudText Typo="Typo.h5" tabindex="-1">@Loc["Transactions.List.Title"] @(_transactions is null ? "" : $"({_transactions.Count})")</MudText>
    <MudSpacer />
    @if (CanAdd)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="@NewTransactionHref">@Loc["Transactions.Add"]</MudButton>
    }
</div>

@if (_error is not null)
{
    <LoadError Message="@_error.Error" Offline="_error.IsNetworkError" What="@Loc["Transactions.List.Title"]" OnRetry="LoadAsync" />
}
else if (_transactions is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else
{
    <MudGrid Spacing="2" Class="mb-3">
        <MudItem xs="6">
            <MudPaper Class="pa-3 summary-tile" Elevation="1">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Loc["Common.Total"]</MudText>
                <MudText Typo="Typo.h6" Color="Color.Success">@Money.Format(TotalBalance)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6">
            <MudPaper Class="pa-3 summary-tile" Elevation="1">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Loc["Transactions.List.Count"]</MudText>
                <MudText Typo="Typo.h6" Color="Color.Primary">@_transactions.Count</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <div class="list-toolbar">
        <MudTextField @bind-Value="_search" Immediate="true" DebounceInterval="200" Placeholder="@Loc["Transactions.List.SearchPlaceholder"]"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Clearable="true" Class="list-search" aria-label="@Loc["Transactions.List.SearchAria"]" />
        <MudSelect T="string" @bind-Value="_type" Label="@Loc["Transactions.List.Type"]" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="list-filter">
            <MudSelectItem Value="@("all")">@Loc["Transactions.List.AllTypes"]</MudSelectItem>
            <MudSelectItem Value="@("PaymentIn")">@Loc["TxnType.PaymentIn"]</MudSelectItem>
            <MudSelectItem Value="@("PaymentOut")">@Loc["TxnType.PaymentOut"]</MudSelectItem>
            <MudSelectItem Value="@("Expense")">@Loc["Transactions.Type.Expense"]</MudSelectItem>
            <MudSelectItem Value="@("OtherIncome")">@Loc["TxnType.OtherIncome"]</MudSelectItem>
            <MudSelectItem Value="@("TransferMoney")">@Loc["Transactions.List.Transfer"]</MudSelectItem>
        </MudSelect>
        <MudSelect T="string" @bind-Value="_sort" Label="@Loc["Transactions.List.Sort"]" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="list-filter">
            <MudSelectItem Value="@("latest")">@Loc["Transactions.List.LatestFirst"]</MudSelectItem>
            <MudSelectItem Value="@("oldest")">@Loc["Transactions.List.OldestFirst"]</MudSelectItem>
            <MudSelectItem Value="@("amount-desc")">@Loc["Transactions.List.AmountHighLow"]</MudSelectItem>
            <MudSelectItem Value="@("amount")">@Loc["Transactions.List.AmountLowHigh"]</MudSelectItem>
        </MudSelect>
    </div>

    @if (_transactions.Count == 0)
    {
        <MudPaper Class="pa-6 text-center" Elevation="0" Outlined="true">
            <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Large" Class="mud-text-secondary" />
            <MudText Typo="Typo.subtitle1" Class="mt-2">@Loc["Transactions.List.EmptyTitle"]</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@Loc["Transactions.List.EmptyBody"]</MudText>
            @if (CanAdd)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@NewTransactionHref">@Loc["Shell.AddTransaction"]</MudButton>
            }
        </MudPaper>
    }
    else if (!Shown.Any())
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">@Loc["Transactions.List.NoMatch"]</MudText>
    }
    else
    {
        <MudPaper Elevation="1" Class="row-list">
            @foreach (var txn in Shown)
            {
                <a class="row-item" href="@($"transactions/{txn.Id}/edit")">
                    <MudAvatar Color="@TransactionColor(txn.Type)" Size="Size.Medium" Variant="Variant.Outlined">
                        <MudIcon Icon="@Icons.Material.Filled.Receipt" />
                    </MudAvatar>
                    <div class="row-main">
                        <div class="row-title">@Loc[MasterLabels.TransactionType(txn.Type)]</div>
                        <div class="row-sub">@(txn.Remarks ?? "---") · @Session.FormatDate(txn.Date)</div>
                    </div>
                    <div class="row-amount">
                        <MudText Typo="Typo.body1" Color="@TransactionAmountColor(txn)" Class="text-nowrap">@Money.Format(txn.Amount)</MudText>
                    </div>
                    @if (txn.Status == "Void")
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error" Class="ms-2">@Loc["Transactions.List.Void"]</MudText>
                    }
                </a>
            }
        </MudPaper>
    }
}

@code {
    private List<TransactionDto>? _transactions;
    private ApiResult<List<TransactionDto>>? _error;
    private string? _search;
    private string _type = "all";
    private string _sort = "latest";

    private bool CanAdd => Enum.GetValues<TransactionType>().Any(t => Session.Can(EntryRules.PermissionFor(t, EntryAction.Create)));

    private string NewTransactionHref => "transactions/new";

    private IEnumerable<TransactionDto> Shown
    {
        get
        {
            var query = _transactions!.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                query = query.Where(t => t.Type.Contains(s, StringComparison.CurrentCultureIgnoreCase)
                                         || (t.Remarks?.Contains(s, StringComparison.CurrentCultureIgnoreCase) ?? false)
                                         || Session.FormatDate(t.Date).Contains(s, StringComparison.Ordinal)); // as shown: miti or AD
            }

            if (_type != "all")
            {
                query = query.Where(t => t.Type == _type);
            }

            return _sort switch
            {
                "oldest" => query.OrderBy(t => t.Date).ThenBy(t => t.Id),
                "amount-desc" => query.OrderByDescending(t => t.Amount),
                "amount" => query.OrderBy(t => t.Amount),
                _ => query.OrderByDescending(t => t.Date).ThenByDescending(t => t.Id),
            };
        }
    }

    private decimal TotalBalance =>
        _transactions?.Sum(t => t.Type is "PaymentIn" or "OtherIncome" ? t.Amount : -t.Amount) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Session.CurrentCompany is not { } company)
        {
            return;
        }

        _error = null;
        _transactions = null;
        var result = await Data.GetTransactionsAsync(company.CompanyId);
        if (result.Ok)
        {
            _transactions = result.Value!;
        }
        else
        {
            _error = result;
        }
    }

    private static Color TransactionColor(string type) => type switch
    {
        "PaymentIn" or "OtherIncome" => Color.Success,
        "PaymentOut" or "Expense" => Color.Error,
        _ => Color.Primary,
    };

    private static Color TransactionAmountColor(TransactionDto txn) => TransactionColor(txn.Type);
}
