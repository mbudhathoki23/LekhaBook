@page "/transactions"
@using LekhaBook.Domain
@using LekhaBook.UI.Formatting
@inject IDataService Data
@inject ISessionService Session

<PageTitle>@Loc["Transactions.List.Title"] · Lekha Books</PageTitle>

<div class="transaction-list">
    <header class="transaction-header">
        <h1 tabindex="-1">@Loc["Transactions.List.Title"]</h1>
        @if (CanAdd)
        {
            <MudButton Class="add-transaction" Variant="Variant.Filled" DropShadow="false" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add" Href="@NewTransactionHref">@Loc["Transactions.Add"]</MudButton>
        }
    </header>

    @if (_error is not null)
    {
        <LoadError Message="@_error.Error" Offline="_error.IsNetworkError" What="@Loc["Transactions.List.Title"]" OnRetry="LoadAsync" />
    }
    else if (_transactions is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@Loc["Shell.Loading"]" />
    }
    else
    {
        <dl class="transaction-summary">
            <div>
                <dt>@Loc["Common.Total"]</dt>
                <dd>@Money.Format(TotalBalance)</dd>
            </div>
            <div>
                <dt>@Loc["Transactions.List.Count"]</dt>
                <dd>@_transactions.Count</dd>
            </div>
        </dl>

        <section class="transaction-panel" aria-label="@Loc["Transactions.List.Title"]">
            @if (_transactions.Count == 0)
            {
                <div class="transaction-empty">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Large" Color="Color.Primary" aria-hidden="true" />
                    <h2>@Loc["Transactions.List.EmptyTitle"]</h2>
                    <p>@Loc["Transactions.List.EmptyBody"]</p>
                    @if (CanAdd)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@NewTransactionHref">@Loc["Shell.AddTransaction"]</MudButton>
                    }
                </div>
            }
            else
            {
                <div class="transaction-filters" role="search" aria-label="@Loc["Transactions.List.SearchAria"]">
                    <MudTextField @bind-Value="_search" Immediate="true" DebounceInterval="200" Placeholder="@Loc["Transactions.List.SearchAria"]"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" Clearable="true" Class="transaction-search" aria-label="@Loc["Transactions.List.SearchAria"]" />
                    <MudSelect T="string" @bind-Value="_type" Label="@Loc["Transactions.List.Type"]" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem Value="@("all")">@Loc["Transactions.List.AllTypes"]</MudSelectItem>
                        <MudSelectItem Value="@("PaymentIn")">@Loc["TxnType.PaymentIn"]</MudSelectItem>
                        <MudSelectItem Value="@("PaymentOut")">@Loc["TxnType.PaymentOut"]</MudSelectItem>
                        <MudSelectItem Value="@("Expense")">@Loc["Transactions.Type.Expense"]</MudSelectItem>
                        <MudSelectItem Value="@("OtherIncome")">@Loc["TxnType.OtherIncome"]</MudSelectItem>
                        <MudSelectItem Value="@("TransferMoney")">@Loc["Transactions.List.Transfer"]</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="_sort" Label="@Loc["Transactions.List.Sort"]" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem Value="@("latest")">@Loc["Transactions.List.LatestFirst"]</MudSelectItem>
                        <MudSelectItem Value="@("oldest")">@Loc["Transactions.List.OldestFirst"]</MudSelectItem>
                        <MudSelectItem Value="@("amount-desc")">@Loc["Transactions.List.AmountHighLow"]</MudSelectItem>
                        <MudSelectItem Value="@("amount")">@Loc["Transactions.List.AmountLowHigh"]</MudSelectItem>
                    </MudSelect>
                </div>

                var shown = Shown.ToList();
                @if (shown.Count == 0)
                {
                    <p class="transaction-empty" role="status">@Loc["Transactions.List.NoMatch"]</p>
                }
                else
                {
                    <ul class="transaction-rows" role="list">
                        @foreach (var txn in shown)
                        {
                            <li @key="txn.Id">
                                <a class="transaction-row" href="@($"transactions/{txn.Id}/edit")">
                                    <span class="transaction-icon @TransactionTone(txn.Type)">
                                        <MudIcon Icon="@TransactionIcon(txn.Type)" Size="Size.Small" aria-hidden="true" />
                                    </span>
                                    <span class="transaction-description">
                                        <strong>@Loc[MasterLabels.TransactionType(txn.Type)]</strong>
                                        <span class="transaction-meta">
                                            <time datetime="@txn.Date.ToString("O")">@Session.FormatDate(txn.Date)</time>
                                            @if (!string.IsNullOrWhiteSpace(txn.Remarks))
                                            {
                                                <span class="transaction-note">@txn.Remarks</span>
                                            }
                                        </span>
                                    </span>
                                    <span class="transaction-amount @TransactionTone(txn.Type)">
                                        @Money.Format(txn.Amount)
                                        @if (txn.Status == "Void")
                                        {
                                            <small>@Loc["Transactions.List.Void"]</small>
                                        }
                                    </span>
                                    <span class="transaction-chevron rtl-flip-icon" aria-hidden="true">
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            }
        </section>
    }
</div>

@code {
    private List<TransactionDto>? _transactions;
    private ApiResult<List<TransactionDto>>? _error;
    private string? _search;
    private string _type = "all";
    private string _sort = "latest";

    private bool CanAdd => Enum.GetValues<TransactionType>().Any(t => Session.Can(EntryRules.PermissionFor(t, EntryAction.Create)));

    private string NewTransactionHref => "transactions/new";

    private IEnumerable<TransactionDto> Shown
    {
        get
        {
            var query = _transactions!.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                query = query.Where(t => t.Type.Contains(s, StringComparison.CurrentCultureIgnoreCase)
                                         || (t.Remarks?.Contains(s, StringComparison.CurrentCultureIgnoreCase) ?? false)
                                         || Session.FormatDate(t.Date).Contains(s, StringComparison.Ordinal)); // as shown: miti or AD
            }

            if (_type != "all")
            {
                query = query.Where(t => t.Type == _type);
            }

            return _sort switch
            {
                "oldest" => query.OrderBy(t => t.Date).ThenBy(t => t.Id),
                "amount-desc" => query.OrderByDescending(t => t.Amount),
                "amount" => query.OrderBy(t => t.Amount),
                _ => query.OrderByDescending(t => t.Date).ThenByDescending(t => t.Id),
            };
        }
    }

    /// <summary>Money in less money out. Transfers and balance adjustments are neither.</summary>
    private decimal TotalBalance => LekhaBook.Application.EntryReports.Totals(_transactions ?? []).Net;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Session.CurrentCompany is not { } company)
        {
            return;
        }

        _error = null;
        _transactions = null;
        var result = await Data.GetTransactionsAsync(company.CompanyId);
        if (result.Ok)
        {
            _transactions = result.Value!;
        }
        else
        {
            _error = result;
        }
    }

    private static string TransactionTone(string type) => type switch
    {
        "PaymentIn" or "OtherIncome" => "incoming",
        "PaymentOut" or "Expense" => "outgoing",
        _ => "",
    };

    private static string TransactionIcon(string type) => type switch
    {
        "PaymentIn" => Icons.Material.Filled.CallReceived,
        "PaymentOut" => Icons.Material.Filled.CallMade,
        "OtherIncome" => Icons.Material.Filled.Savings,
        "TransferMoney" => Icons.Material.Filled.SwapHoriz,
        _ => Icons.Material.Filled.ReceiptLong,
    };
}
