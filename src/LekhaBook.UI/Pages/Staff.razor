@page "/staff"
@using P = LekhaBook.Domain.Permission
@implements IDisposable
@inject ISessionService Session
@inject ICompanyApi Companies
@inject IPlatformInfo Platform
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@Loc["Staff.PageTitle"]</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5" tabindex="-1">@Loc["Settings.Staff"]</MudText>
    <MudSpacer />
    @if (Session.Can(P.StaffCreate) && !_showInvite)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="() => _showInvite = true">@Loc["Staff.Invite.Button"]</MudButton>
    }
</MudStack>

@if (!Session.Can(P.StaffView))
{
    <MudAlert Severity="Severity.Info">@(Loc["Staff.NoPermission", Session.CompanyName ?? string.Empty])</MudAlert>
    return;
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert>
}

@if (_newInvite is { } invite)
{
    <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _newInvite = null">
        <MudText Typo="Typo.subtitle2">@(Loc["Staff.Invite.CreatedFor", _invitedEmail ?? string.Empty])</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            @(Loc["Staff.Invite.SendCode", Session.FormatDay(invite.ExpiresAtUtc)])
            @((MarkupString)Loc["Staff.Invite.SignInHint", $"<b>{Loc["Settings.JoinCompany"]}</b>"].ToString())
        </MudText>
        <MudTextField Value="@InviteText" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                      OnAdornmentClick="CopyInviteAsync" AdornmentAriaLabel="@Loc["Staff.Invite.CopyAria"]" />
    </MudAlert>
}

@if (_showInvite)
{
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-3">@Loc["Staff.Invite.Heading"]</MudText>
        <form @onsubmit="InviteAsync">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_inviteName" Label="@Loc["Common.Name"]" Variant="Variant.Outlined" Immediate="true" Required="true"
                                  AutoFocus="true" UserAttributes="@(new() { ["enterkeyhint"] = "next" })" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_inviteEmail" Label="@Loc["Common.Email"]" InputType="InputType.Email" Variant="Variant.Outlined"
                                  Immediate="true" Required="true"
                                  UserAttributes="@(new() { ["inputmode"] = "email", ["enterkeyhint"] = "next" })" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="_inviteRole" Label="@Loc["Common.Role"]" Variant="Variant.Outlined"
                               HelperText="@Loc[RoleLabels.Describe(_inviteRole)]">
                        @foreach (var role in RoleLabels.Assignable)
                        {
                            <MudSelectItem Value="@role">@Loc[RoleLabels.For(role)]</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center justify-end gap-2">
                    <MudButton Variant="Variant.Text" OnClick="() => _showInvite = false">@Loc["Common.Cancel"]</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">@Loc["Staff.Invite.Create"]</MudButton>
                </MudItem>
            </MudGrid>
        </form>
    </MudPaper>
}

@if (_members is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudTable Items="_members" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Elevation="1" Class="mb-6">
        <HeaderContent>
            <MudTh>@Loc["Common.Name"]</MudTh>
            <MudTh>@Loc["Common.Role"]</MudTh>
            <MudTh>@Loc["Common.Status"]</MudTh>
            <MudTh>@Loc["Staff.Member.Joined"]</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@Loc["Common.Name"]">@context.DisplayName @(context.UserId == Session.Me?.UserId ? Loc["Staff.Member.You"] : "")</MudTd>
            <MudTd DataLabel="@Loc["Common.Role"]">
                @Loc[RoleLabels.For(context.Role)]
                @if (context.CustomPermissions is not null)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ml-1">@Loc["Staff.Member.Custom"]</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="@Loc["Common.Status"]">
                <MudChip T="string" Size="Size.Small" Color="@(context.Status == "Active" ? Color.Success : Color.Default)">@(Loc["Staff.Status." + context.Status])</MudChip>
            </MudTd>
            <MudTd DataLabel="@Loc["Staff.Member.Joined"]">@Session.FormatDay(context.JoinedAtUtc)</MudTd>
            <MudTd>
                @if (CanManage(context))
                {
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="@(Loc["Staff.Member.Manage", context.DisplayName])" Dense="true">
                        @if (Session.Can(P.StaffEdit))
                        {
                            @foreach (var role in RoleLabels.Assignable.Where(r => r != context.Role))
                            {
                                <MudMenuItem OnClick="() => ChangeRoleAsync(context, role)">@(Loc["Staff.Role.Make", Loc[RoleLabels.For(role)]])</MudMenuItem>
                            }
                        }
                        @if (Session.Can(P.StaffDelete))
                        {
                            <MudMenuItem OnClick="() => RevokeAsync(context)" Icon="@Icons.Material.Filled.PersonRemove" IconColor="Color.Error">
                                @Loc["Staff.Member.RemoveAccess"]
                            </MudMenuItem>
                        }
                    </MudMenu>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>

    @if (_invitations is { Count: > 0 })
    {
        <MudText Typo="Typo.subtitle1" Class="mb-2">@Loc["Staff.Invite.Pending"]</MudText>
        <MudTable Items="_invitations" Dense="true" Breakpoint="Breakpoint.Sm" Elevation="1">
            <HeaderContent>
                <MudTh>@Loc["Common.Name"]</MudTh>
                <MudTh>@Loc["Common.Email"]</MudTh>
                <MudTh>@Loc["Common.Role"]</MudTh>
                <MudTh>@Loc["Staff.Invite.Expires"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Loc["Common.Name"]">@context.DisplayName</MudTd>
                <MudTd DataLabel="@Loc["Common.Email"]">@context.Email</MudTd>
                <MudTd DataLabel="@Loc["Common.Role"]">@Loc[RoleLabels.For(context.Role)]</MudTd>
                <MudTd DataLabel="@Loc["Staff.Invite.Expires"]">@Session.FormatDay(context.ExpiresAtUtc)</MudTd>
                <MudTd>
                    @if (Session.Can(P.StaffCreate))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => CancelInviteAsync(context)">@Loc["Common.Cancel"]</MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    private List<MemberDto>? _members;
    private List<InvitationDto>? _invitations;
    private string? _error;
    private bool _busy;

    private bool _showInvite;
    private string _inviteName = string.Empty;
    private string _inviteEmail = string.Empty;
    private string _inviteRole = "EntryPerson";
    private InviteResponse? _newInvite;
    private string? _invitedEmail;

    private Guid CompanyId => Session.CurrentCompany!.CompanyId;

    /// <summary>The web app can share a link; the phone app shares the code.</summary>
    private string InviteText => Platform.Platform == "Web"
        ? $"{Navigation.BaseUri}invite?token={_newInvite!.Token}"
        : _newInvite!.Token;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        await LoadAsync();
    }

    private bool CanManage(MemberDto member) =>
        member.Role != "Owner" && member.UserId != Session.Me?.UserId && member.Status == "Active"
        && (Session.Can(P.StaffEdit) || Session.Can(P.StaffDelete));

    private async Task LoadAsync()
    {
        if (Session.CurrentCompany is null || !Session.Can(P.StaffView))
        {
            return;
        }

        var members = await Companies.GetMembersAsync(CompanyId);
        if (await HandleAsync(members))
        {
            _members = members.Value;
        }

        var invitations = await Companies.GetInvitationsAsync(CompanyId);
        _invitations = invitations.Ok ? invitations.Value : [];
    }

    private async Task InviteAsync()
    {
        if (string.IsNullOrWhiteSpace(_inviteName) || string.IsNullOrWhiteSpace(_inviteEmail))
        {
            _error = Loc["Staff.Invite.NameEmailRequired"];
            return;
        }

        _busy = true;
        var result = await Companies.InviteAsync(CompanyId, new InviteRequest(_inviteEmail.Trim(), _inviteName.Trim(), _inviteRole));
        _busy = false;
        if (await HandleAsync(result))
        {
            _newInvite = result.Value;
            _invitedEmail = _inviteEmail.Trim();
            _showInvite = false;
            _inviteName = _inviteEmail = string.Empty;
            await LoadAsync();
        }
    }

    private async Task ChangeRoleAsync(MemberDto member, string role)
    {
        var result = await Companies.UpdateMemberAsync(CompanyId, member.MemberId, new UpdateMemberRequest(role));
        if (await HandleAsync(result))
        {
            Snackbar.Add(Loc["Staff.Role.Changed", member.DisplayName, Loc[RoleLabels.For(role)]], Severity.Success);
            await LoadAsync();
        }
    }

    private async Task RevokeAsync(MemberDto member)
    {
        var result = await Companies.RevokeMemberAsync(CompanyId, member.MemberId);
        if (await HandleAsync(result))
        {
            Snackbar.Add(Loc["Staff.Member.Revoked", member.DisplayName, Session.CompanyName ?? string.Empty], Severity.Info);
            await LoadAsync();
        }
    }

    private async Task CancelInviteAsync(InvitationDto invitation)
    {
        if (await HandleAsync(await Companies.CancelInvitationAsync(CompanyId, invitation.InvitationId)))
        {
            await LoadAsync();
        }
    }

    private async Task CopyInviteAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", InviteText);
            Snackbar.Add(Loc["Staff.Invite.Copied"], Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add(Loc["Staff.Invite.CopyFailed"], Severity.Warning);
        }
    }

    /// <summary>Shows the error; on 403 the user's access may have changed, so reload it.</summary>
    private async Task<bool> HandleAsync<T>(ApiResult<T> result)
    {
        _error = result.Error;
        if (result.IsForbidden)
        {
            await Session.RefreshAsync();
        }

        return result.Ok;
    }

    private void OnSessionChanged(object? sender, EventArgs e) => _ = InvokeAsync(async () =>
    {
        _members = null;
        _invitations = null;
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
