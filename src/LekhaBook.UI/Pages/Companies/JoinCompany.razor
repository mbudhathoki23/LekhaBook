@page "/invite"
@inject ISessionService Session
@inject ICompanyApi Companies
@inject NavigationManager Navigation

<PageTitle>@Loc["Companies.Join.PageTitle"]</PageTitle>

<MudPaper Class="pa-5 mx-auto" Style="max-width: 560px;" Elevation="1">
    <MudText Typo="Typo.h5" Class="mb-1" tabindex="-1">@Loc["Companies.Join.Title"]</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
        @(Loc["Companies.Join.Intro", Session.Me?.Email ?? string.Empty])
    </MudText>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
    }

    <form @onsubmit="AcceptAsync">
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_token" Label="@Loc["Companies.Join.Code"]" Variant="Variant.Outlined" Immediate="true" Required="true"
                          AutoFocus="true" UserAttributes="@(new() { ["autocomplete"] = "off", ["enterkeyhint"] = "go", ["autocapitalize"] = "off" })" />
            <MudStack Row="true" Justify="Justify.FlexEnd">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">@Loc["Companies.Join.Submit"]</MudButton>
            </MudStack>
        </MudStack>
    </form>
</MudPaper>

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private string _token = string.Empty;
    private string? _error;
    private bool _busy;

    protected override void OnInitialized() => _token = Token ?? string.Empty;

    private async Task AcceptAsync()
    {
        if (string.IsNullOrWhiteSpace(_token))
        {
            _error = Loc["Companies.Join.CodeRequired"];
            return;
        }

        _busy = true;
        var result = await Companies.AcceptInvitationAsync(_token);
        if (result.Ok)
        {
            await Session.RefreshAsync();
            await Session.SelectCompanyAsync(result.Value!.CompanyId);
            Navigation.NavigateTo("");
        }

        _error = result.Error;
        _busy = false;
    }
}
