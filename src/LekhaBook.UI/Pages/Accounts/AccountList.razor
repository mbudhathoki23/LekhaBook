@page "/accounts"
@using LekhaBook.Domain
@using LekhaBook.UI.Formatting
@inject IDataService Data
@inject ISessionService Session

<PageTitle>@Loc["Accounts.List.Title"] · Lekha Books</PageTitle>

<div class="page-header">
    <MudText Typo="Typo.h5" tabindex="-1">@Loc["Accounts.List.Title"] @(_accounts is null ? "" : $"({_accounts.Count})")</MudText>
    <MudSpacer />
    @if (Session.Can(Permission.AccountsAdd))
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="accounts/new">@Loc["Accounts.Add"]</MudButton>
    }
</div>

@if (!Session.Can(Permission.AccountsView))
{
    <MudAlert Severity="Severity.Info">@Loc["Accounts.List.NoViewPermission"]</MudAlert>
}
else if (_error is not null)
{
    <LoadError Message="@_error.Error" Offline="_error.IsNetworkError" What="@Loc["Accounts.List.Subject"]" OnRetry="LoadAsync" />
}
else if (_accounts is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else
{
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Loc["Accounts.List.TotalBalance"]</MudText>
        <MudText Typo="Typo.h5" Color="@(Total < 0 ? Color.Error : Color.Default)">@Money.Format(Total)</MudText>
    </MudPaper>

    <MudPaper Elevation="1" Class="row-list">
        @foreach (var account in _accounts)
        {
            <a class="row-item" href="@($"accounts/{account.Id}")">
                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium">
                    <MudIcon Icon="@MasterLabels.AccountIcon(account.Type)" />
                </MudAvatar>
                <div class="row-main">
                    <div class="row-title">@account.Name</div>
                    <div class="row-sub">
                        @Loc[MasterLabels.AccountType(account.Type)]@(MasterLabels.MaskNumber(account.AccountNumber) is { } masked ? $" · {masked}" : "")
                    </div>
                </div>
                <div class="row-amount">
                    <MudText Typo="Typo.body1" Color="@(account.Balance < 0 ? Color.Error : Color.Default)" Class="text-nowrap">@Money.Format(account.Balance)</MudText>
                </div>
            </a>
        }
    </MudPaper>
}

@code {
    private List<MoneyAccountDto>? _accounts;
    private ApiResult<List<MoneyAccountDto>>? _error;

    private decimal Total => _accounts?.Sum(a => a.Balance) ?? 0;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (Session.CurrentCompany is not { } company || !Session.Can(Permission.AccountsView))
        {
            return;
        }

        _error = null;
        _accounts = null;
        var result = await Data.GetMoneyAccountsAsync(company.CompanyId);
        if (result.Ok)
        {
            _accounts = result.Value!;
        }
        else
        {
            _error = result;
        }
    }
}
