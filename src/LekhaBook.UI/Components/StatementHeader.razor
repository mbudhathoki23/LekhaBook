@using LekhaBook.UI.Formatting
@inject ICompanyApi Companies
@inject ISessionService Session
@inject IJSRuntime JS
@inject IDialogService Dialogs

@* The heading of a party or account statement: who issued it, who it is for, the period and when it was printed. *@
<div class="statement-header">
    <div class="statement-brand">
        <CompanyLogo CompanyId="CompanyId" Size="72" />
        <div class="statement-company">
            <div class="statement-company-name">@(_company?.Name ?? Session.CompanyName)</div>
            @if (!string.IsNullOrWhiteSpace(_company?.Address))
            {
                <div class="statement-field">@_company.Address</div>
            }
            @if (!string.IsNullOrWhiteSpace(_company?.Phone))
            {
                <div class="statement-field"><span class="statement-label">@Loc["Common.Phone"]</span>@_company.Phone</div>
            }
            @if (!string.IsNullOrWhiteSpace(_company?.Pan))
            {
                <div class="statement-field"><span class="statement-label">@Loc["Statement.Pan"]</span>@_company.Pan</div>
            }
        </div>
    </div>

    <div class="statement-meta">
        <div class="statement-title">@(Party is not null ? Loc["Statement.PartyTitle"] : Loc["Statement.AccountTitle"])</div>
        @if (Party is { } party)
        {
            <div class="statement-field"><span class="statement-label">@Loc["Statement.Type"]</span>@(party.PartyType == "Supplier" ? Loc["Parties.Type.Supplier"] : Loc["Parties.Type.Customer"])</div>
            @if (!string.IsNullOrWhiteSpace(party.Phone))
            {
                <div class="statement-field"><span class="statement-label">@Loc["Common.Phone"]</span>@party.Phone</div>
            }
            @if (!string.IsNullOrWhiteSpace(party.Email))
            {
                <div class="statement-field"><span class="statement-label">@Loc["Common.Email"]</span>@party.Email</div>
            }
            @if (!string.IsNullOrWhiteSpace(party.Address))
            {
                <div class="statement-field"><span class="statement-label">@Loc["Statement.Address"]</span>@party.Address</div>
            }
            @if (!string.IsNullOrWhiteSpace(party.Pan))
            {
                <div class="statement-field"><span class="statement-label">@Loc["Statement.Pan"]</span>@party.Pan</div>
            }
        }
        else if (Account is { } account)
        {
            <div class="statement-field"><span class="statement-label">@Loc["Statement.Type"]</span>@Loc[MasterLabels.AccountType(account.Type)]</div>
            @if (!string.IsNullOrWhiteSpace(account.AccountHolderName))
            {
                <div class="statement-field"><span class="statement-label">@Loc["Statement.AccountHolder"]</span>@account.AccountHolderName</div>
            }
            @if (MasterLabels.MaskNumber(account.AccountNumber) is { } masked)
            {
                <div class="statement-field"><span class="statement-label">@Loc["Statement.AccountNumber"]</span>@masked</div>
            }
        }
        <div class="statement-field"><span class="statement-label">@Loc["Statement.Period"]</span>@PeriodText</div>
        <div class="statement-field">@Loc["Statement.PrintDate", Session.FormatDate(DateOnly.FromDateTime(DateTime.Today))]</div>
    </div>

    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="no-print">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintAsync">@Loc["Statement.Print"]</MudButton>
        @if (Session.Can(LekhaBook.Domain.Permission.ReportsExport) && (Party is not null || Account is not null))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Share" OnClick="ShareAsync">@Loc["Share.Button"]</MudButton>
        }
    </MudStack>
</div>

@code {
    [Parameter, EditorRequired]
    public Guid CompanyId { get; set; }

    [Parameter, EditorRequired]
    public LedgerDto Ledger { get; set; } = null!;

    /// <summary>Set for a party statement.</summary>
    [Parameter]
    public PartyDto? Party { get; set; }

    /// <summary>Set for an account statement.</summary>
    [Parameter]
    public MoneyAccountDto? Account { get; set; }

    private CompanyDetails? _company;
    private Guid _loadedFor;

    private string PeriodText => PeriodOf(Ledger) is var (from, to)
        ? Loc["Statement.PeriodValue", Session.FormatDate(from), Session.FormatDate(to)].Value
        : "–";

    /// <summary>
    /// The earliest and latest date on the statement, opening-as-of included; null when there are no lines.
    /// An entry may be dated before the opening-as-of date, so neither end is taken from a fixed row.
    /// </summary>
    public static (DateOnly From, DateOnly To)? PeriodOf(LedgerDto ledger)
    {
        if (ledger.Lines.Count == 0)
        {
            return null;
        }

        var dates = ledger.Lines.Select(l => l.Date).ToList();
        if (ledger.OpeningAsOf is { } openingAsOf)
        {
            dates.Add(openingAsOf);
        }

        return (dates.Min(), dates.Max());
    }

    protected override async Task OnParametersSetAsync()
    {
        if (CompanyId == _loadedFor)
        {
            return;
        }

        _loadedFor = CompanyId;
        _company = null;
        var companyId = CompanyId;
        var result = await Companies.GetCompanyAsync(companyId);
        if (companyId == _loadedFor)
        {
            _company = result.Value; // the header still works without it, using the session's name
        }
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("window.print");

    private async Task ShareAsync()
    {
        var parameters = new DialogParameters<ShareReportDialog>
        {
            { x => x.CompanyId, CompanyId },
            { x => x.AccountId, Ledger.AccountId },
            { x => x.Name, Party?.Name ?? Account!.Name },
            { x => x.Phone, Party?.Phone },
            { x => x.Email, Party?.Email },
        };
        await Dialogs.ShowAsync<ShareReportDialog>(Loc["Share.Title"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true });
    }
}
