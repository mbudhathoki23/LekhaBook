@using LekhaBook.Application
@using LekhaBook.Domain
@inject ISessionService Session
@inject IPlatformInfo Platform
@inject IJSRuntime JS
@implements IAsyncDisposable

@* The top of every report: back to the list, title, period, print and CSV. *@
<MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" IconClass="mud-flip-x-rtl" Href="reports" Class="mb-2 no-print">@Loc["Nav.Reports"]</MudButton>

<div class="page-header">
    <MudText Typo="Typo.h5" tabindex="-1">@Title</MudText>
    <MudSpacer />
    @if (CanExport)
    {
        <MudStack Row="true" Spacing="2" Class="no-print">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" Class="report-print"
                       OnClick="PrintAsync">@Loc["Reports.Print"]</MudButton>
            @* The Android and iOS web views can't save a file from the page. *@
            @if (Csv is not null && Platform.Platform is "Web" or "Windows")
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" Class="report-csv"
                           OnClick="DownloadAsync">@Loc["Reports.Csv"]</MudButton>
            }
        </MudStack>
    }
</div>

@if (ShowPeriod)
{
    <div class="d-flex flex-wrap gap-3 mb-3 no-print">
        <MudSelect T="PeriodPreset" Value="Preset" ValueChanged="ChoosePresetAsync" Label="@Loc["Reports.Period"]"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width: 220px">
            @foreach (var preset in Enum.GetValues<PeriodPreset>())
            {
                <MudSelectItem T="PeriodPreset" Value="preset">@Loc[$"Reports.Period.{preset}"]</MudSelectItem>
            }
        </MudSelect>
        @if (Preset == PeriodPreset.Custom)
        {
            <DateField Label="@Loc["Reports.From"]" Value="ToDateTime(Range.From)" ValueChanged="v => SetCustomAsync(v, ToDateTime(Range.To))" />
            <DateField Label="@Loc["Reports.To"]" Value="ToDateTime(Range.To)" ValueChanged="v => SetCustomAsync(ToDateTime(Range.From), v)" />
        }
    </div>
}

<MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@Session.CompanyName@(ShowPeriod ? $" · {PeriodText}" : "")</MudText>

@code {
    private IJSObjectReference? _module;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public bool ShowPeriod { get; set; } = true;

    [Parameter]
    public PeriodPreset Preset { get; set; }

    [Parameter]
    public ReportRange Range { get; set; }

    /// <summary>The company's today, which presets count from.</summary>
    [Parameter]
    public DateOnly Today { get; set; }

    [Parameter]
    public int FiscalYearStartMonth { get; set; } = 4;

    /// <summary>Raised with the new preset and the dates it covers.</summary>
    [Parameter]
    public EventCallback<(PeriodPreset Preset, ReportRange Range)> PeriodChanged { get; set; }

    /// <summary>Builds the CSV of what is on screen; null when there is nothing to export.</summary>
    [Parameter]
    public Func<string>? Csv { get; set; }

    [Parameter]
    public string FileName { get; set; } = "report";

    private bool CanExport => Session.Can(Permission.ReportsExport);

    private string PeriodText => (Range.From, Range.To) switch
    {
        (null, null) => Loc["Reports.Period.AllTime"],
        ({ } from, { } to) when from == to => Session.FormatDate(from),
        _ => Loc["Statement.PeriodValue",
            Range.From is { } f ? Session.FormatDate(f) : "…",
            Range.To is { } t ? Session.FormatDate(t) : "…"],
    };

    private static DateTime? ToDateTime(DateOnly? date) => date?.ToDateTime(TimeOnly.MinValue);

    private Task ChoosePresetAsync(PeriodPreset preset)
    {
        // Choosing "Custom" starts from the dates shown now.
        var range = preset == PeriodPreset.Custom
            ? Range
            : ReportPeriods.For(preset, Today, Session.Calendar(), FiscalYearStartMonth);
        return PeriodChanged.InvokeAsync((preset, range));
    }

    private Task SetCustomAsync(DateTime? from, DateTime? to) => PeriodChanged.InvokeAsync((PeriodPreset.Custom, new ReportRange(
        from is { } f ? DateOnly.FromDateTime(f) : null,
        to is { } t ? DateOnly.FromDateTime(t) : null)));

    private async Task PrintAsync() => await JS.InvokeVoidAsync("window.print");

    private async Task DownloadAsync()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/LekhaBook.UI/js/download.js");
        await _module.InvokeVoidAsync("saveText", $"{FileName}-{Today:yyyy-MM-dd}.csv", Csv!());
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
