@* Shown inside the app when the user has no company yet (new account, or access removed). *@
<MudPaper Class="pa-6 mx-auto" Style="max-width: 520px;" Elevation="1">
    <MudText Typo="Typo.h5" Class="mb-2" tabindex="-1">@Loc["Shell.SetUpTitle"]</MudText>
    <MudText Class="mb-5">
        @Loc["Shell.SetUpText"]
    </MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddBusiness" Href="companies/new">
            @Loc["Settings.CreateCompany"]
        </MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.GroupAdd" Href="invite">
            @Loc["Settings.JoinCompany"]
        </MudButton>
    </MudStack>
</MudPaper>
