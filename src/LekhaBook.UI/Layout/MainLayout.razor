@inherits LayoutComponentBase
@implements IDisposable
@inject ISessionService Session
@inject ISyncService Sync
@inject IThemeService Theme
@inject ILanguageService Language
@inject NavigationManager Navigation
@inject BackNavigator Back

@* The wrapper sets the reading direction (Arabic is right to left) and the language for font choice. *@
<MudRTLProvider RightToLeft="@Languages.IsRightToLeft(Language.CurrentCode)" lang="@Language.CurrentCode">
<MudThemeProvider Theme="AppTheme.Theme" IsDarkMode="@Theme.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (!Session.IsInitialized || !Session.IsSignedIn)
{
    @* Restoring the session, or on the way to the sign-in page. *@
    <div class="brand-loading" role="status" aria-label="@Loc["Shell.Loading"]">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}
else
{
    @* Keyed on the language: a change re-creates the layout and its pages, so every string is looked up again. *@
    <MudLayout @key="_languageVersion">
        <MudAppBar Elevation="1" Dense="true">
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="@Loc["Shell.ToggleMenu"]" OnClick="ToggleDrawer" />
            </MudHidden>
            @* Every screen but the dashboard can go back, on phones and in the browser alike. *@
            @if (CurrentPath.Length > 0)
            {
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" Class="app-back mud-flip-x-rtl"
                       aria-label="@Loc["Shell.Back"]" OnClick="GoBackAsync" />
            }
            <BrandLogo />
            <CompanySwitcher />
            <MudSpacer />
            @if (!IsFormPage)
            {
                <MudMenu Icon="@Icons.Material.Filled.Add" Color="Color.Inherit" Class="quick-add-fab"
                         AriaLabel="@Loc["Shell.AddTransaction"]" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem Icon="@Icons.Material.Filled.ArrowDownward" IconColor="Color.Success" Href="transactions/new?type=PaymentIn">@Loc["TxnType.PaymentIn"]</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.ArrowUpward" IconColor="Color.Error" Href="transactions/new?type=PaymentOut">@Loc["TxnType.PaymentOut"]</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.ReceiptLong" IconColor="Color.Warning" Href="transactions/new?type=Expense">@Loc["Transactions.Type.Expense"]</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Savings" IconColor="Color.Info" Href="transactions/new?type=OtherIncome">@Loc["TxnType.OtherIncome"]</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.SwapHoriz" Href="transactions/new?type=TransferMoney">@Loc["TxnType.TransferMoney"]</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.PersonAdd" Href="parties/new">@Loc["Parties.AddParty"]</MudMenuItem>
                </MudMenu>
            }
            <SyncStatusChip />
        </MudAppBar>

        @* Desktop/tablet: side menu. Phones: bottom navigation instead (below). *@
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive"
                       Breakpoint="Breakpoint.Sm" Elevation="1">
                <NavMenu />
            </MudDrawer>
        </MudHidden>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.Large" Class="@(IsFormPage ? "page-content page-content-form" : "page-content")">
                @if (Session.IsLocalMode && CurrentPath != "upgrade")
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
                            <span>@Loc["Shell.LocalModeBanner"]</span>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.CloudUpload" Href="upgrade">
                                @Loc["Upgrade.Button"]
                            </MudButton>
                        </MudStack>
                    </MudAlert>
                }
                else if (Session.IsOffline)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                        @Loc["Shell.Offline"]
                    </MudAlert>
                }
                @if (Session.CurrentCompany is null && !AllowedWithoutCompany)
                {
                    <NoCompany />
                }
                else
                {
                    <div @key="BodyKey">@Body</div>
                }
            </MudContainer>
        </MudMainContent>

        @* Forms are full screen on phones: the soft keyboard needs the room (AGENT_PLAN § 8.1). *@
        @if (!IsFormPage)
        {
            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <BottomNav />
            </MudHidden>
        }
    </MudLayout>
}

<div id="blazor-error-ui" data-nosnippet>
    @Loc["Shell.UnexpectedError"]
    <a href="." class="reload">@Loc["Shell.Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

</MudRTLProvider>

@code {
    private bool _drawerOpen = true;
    private int _languageVersion;
    private int _syncVersion;

    private string CurrentPath => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');

    /// <summary>The upgrade screen signs in and changes company while it runs: it keeps its progress and errors.</summary>
    private string BodyKey => CurrentPath == "upgrade" ? "upgrade" : $"{Session.CurrentCompany?.CompanyId}:{_syncVersion}";

    /// <summary>Pages that work before the user has a company.</summary>
    private bool AllowedWithoutCompany => CurrentPath is "companies/new" or "invite" or "settings" or "settings/security" or "upgrade" or "sync" or "billing" or "billing/callback"
        || CurrentPath.StartsWith("shared-report/", StringComparison.Ordinal);

    /// <summary>Add and edit forms (…/new, …/edit).</summary>
    private bool IsFormPage => CurrentPath.EndsWith("/new", StringComparison.Ordinal) || CurrentPath.EndsWith("/edit", StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        Navigation.LocationChanged += OnLocationChanged;
        Language.Changed += OnLanguageChanged;
        Theme.Changed += OnThemeChanged;
        Sync.DataChanged += OnSyncDataChanged;
        await Theme.InitializeAsync();
        await Session.InitializeAsync();
        RequireSignIn();
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    /// <summary>The previous screen; the dashboard when there is none, never out of the app.</summary>
    private Task GoBackAsync() => Back.HandleAsync(() => Navigation.NavigateTo(""));

    private void RequireSignIn()
    {
        if (Session.IsInitialized && !Session.IsSignedIn)
        {
            var here = Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo(string.IsNullOrEmpty(here) ? "signin" : $"signin?returnUrl={Uri.EscapeDataString(here)}");
        }
    }

    private void OnSessionChanged(object? sender, EventArgs e) => _ = InvokeAsync(() =>
    {
        RequireSignIn();
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnLanguageChanged(object? sender, EventArgs e) => _ = InvokeAsync(() =>
    {
        _languageVersion++;
        StateHasChanged();
    });

    /// <summary>
    /// Pages that only show the books: rebuilding one loses nothing the user typed. Everything else (forms, settings,
    /// import, security, upgrade, billing) keeps its state and shows new data when next opened.
    /// </summary>
    private bool CanReload => CurrentPath is "" or "parties" or "accounts" or "transactions"
        || (CurrentPath.Split('/') is ["parties" or "accounts", var id] && Guid.TryParse(id, out _));

    private void OnThemeChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    private void OnSyncDataChanged(object? sender, EventArgs e) => _ = InvokeAsync(() =>
    {
        if (CanReload)
        {
            _syncVersion++;
            StateHasChanged();
        }
    });

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        Language.Changed -= OnLanguageChanged;
        Theme.Changed -= OnThemeChanged;
        Sync.DataChanged -= OnSyncDataChanged;
    }
}
