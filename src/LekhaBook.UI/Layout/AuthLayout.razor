@inherits LayoutComponentBase
@implements IDisposable
@inject ISessionService Session
@inject ILanguageService Language
@inject NavigationManager Navigation
@* Layout for sign-in and sign-up: no navigation, centred card. Signed-in users go to the app. *@

@* The wrapper sets the reading direction (Arabic is right to left) and the language for font choice. *@
<MudRTLProvider RightToLeft="@Languages.IsRightToLeft(Language.CurrentCode)" lang="@Language.CurrentCode">
<MudThemeProvider Theme="AppTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="auth-page" @key="_languageVersion">
    <div class="auth-language">
        <LanguageSwitcher />
    </div>
    <div class="auth-card">
        <div class="auth-brand">
            <img src="_content/LekhaBook.UI/branding/lekha_books_mark_small.png" alt="" width="48" height="48" />
            <span>Lekha <span class="brand-logo-books">Books</span></span>
        </div>
        @if (Session.IsInitialized)
        {
            @Body
        }
        else
        {
            <div class="d-flex justify-center pa-6"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
        }
    </div>
</div>

</MudRTLProvider>

@code {
    private int _languageVersion;

    protected override async Task OnInitializedAsync()
    {
        Language.Changed += OnLanguageChanged;
        await Session.InitializeAsync();
        if (Session.IsSignedIn)
        {
            Navigation.NavigateTo("");
        }
    }

    private void OnLanguageChanged(object? sender, EventArgs e) => _ = InvokeAsync(() =>
    {
        _languageVersion++;
        StateHasChanged();
    });

    public void Dispose() => Language.Changed -= OnLanguageChanged;
}
